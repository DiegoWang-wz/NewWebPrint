                              Style="width:100%; height:100%;"/>
            </MudPaper>
        </MudItem>

        <MudItem Class="d-flex align-center justify-center" Style="flex:5;">
            <MudPaper Class="pa-2" Style="width:100%; height:100%;">
                <MudPaper Elevation="2" Class="pa-2 mb-2 print-card">
                    <MudGrid GutterSize="1" AlignItems="AlignItems.Center">
                        <MudItem xs="12" md="12">
                            <MudStack Spacing="1">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudSelect T="string"
                                               Label="@T["SelectPrinter"]"
                                               @bind-Value="SelectedPrinter"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Filled.Print"
                                               Variant="Variant.Outlined"
