                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- 右侧数字键盘 -->
        <MudItem Class="d-flex justify-center align-center" Style="flex:2; min-height:260px;">
            <MudPaper Class="d-flex justify-center align-center pa-2"
                      Style="width:100%; height:100%;">
                <MudStack Class="d-flex justify-center align-center">
                    <NumKeyboard KeyboardWidthPx="350" KeyboardHeightPx="350" KeySpacingPx="15"/>
                </MudStack>
            </MudPaper>
        </MudItem>
