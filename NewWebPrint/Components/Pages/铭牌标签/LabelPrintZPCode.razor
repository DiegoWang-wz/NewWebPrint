<MudPaper Class="px-4 py-2 ma-2 tab-background">
    <MudGrid Spacing="2" AlignItems="AlignItems.Stretch">
        <!-- 左侧：查询条件 -->
        <MudItem xs="12" md="9" Class="d-flex align-center">
            <div class="left-panel">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="12">
                        <KeypadTarget Label='@($"{T["ProductionOrder"]}")'
                                      @bind-Value="ProductionOrder"/>
                    </MudItem>
                    <MudItem xs="12" md="12">
                        <KeypadTarget TValue="int" Label="请输入打印张数"
                                      @bind-Value="PrintCount"/>
                    </MudItem>
                </MudGrid>
            </div>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center justify-center">
            <div class="right-panel">
                <MudStack Row="true"
                          Spacing="1"
                          AlignItems="AlignItems.Stretch"
                          Justify="Justify.SpaceBetween"
                          Class="w-100 compact-stack">
                    <MudButton Variant="Variant.Filled"
                               Class="grow-btn auto-size"
                               OnClick="@SearchSubmit"
                               Disabled="@IsSearching">
                        @(IsSearching ? @T["Searching"] : @T["Search"])
                    </MudButton>
                </MudStack> 
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="px-4 py-2 ma-2 tab-background" Elevation="3" Style="min-height:560px;">
    @if (IsSearching)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Info"/>
    }

    <div class="table-scroll-x">
        <MudTable Items="@ModelItems"
                  T="ModelCode"
                  Hover="true"
                  FixedHeader="true"
                  Height="120px"
                  Breakpoint="Breakpoint.Sm"
                  LoadingProgressColor="Color.Info"
                  OnRowClick="OnRowClicked">

            <HeaderContent>
                <MudTh>车间</MudTh>
                <MudTh>客户</MudTh>
                <MudTh>客户编码</MudTh>
                <MudTh>生产订单</MudTh>
                <MudTh>销售订单</MudTh>
                <MudTh>物料代码</MudTh>
                <MudTh>物料名称</MudTh>
                <MudTh>规格型号</MudTh>
                <MudTh>订单数量</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="@T["Factory"]">@context.SCLine</MudTd>
                <MudTd DataLabel="@T["Workshop"]">@context.client</MudTd>
                <MudTd DataLabel="@T["Order"]">@context.clientCode</MudTd>
                <MudTd DataLabel="@T["OrderLine"]">@context.Production_order_no</MudTd>
                <MudTd DataLabel="@T["OrderDelivery"]">@context.sales_order_no</MudTd>
                <MudTd DataLabel="@T["MaterialCode"]">@context.pruduct_code</MudTd>
                <MudTd DataLabel="@T["MaterialGroup"]">@context.product_name</MudTd>
                <MudTd DataLabel="@T["MaterialName"]">@context.product_model</MudTd>
                <MudTd DataLabel="@T["MaterialModel"]">@context.Production_order_sum</MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4" Typo="Typo.subtitle2" Align="Align.Center" Color="Color.Secondary">
                    @T["NonData"]
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </div>

    <MudGrid Spacing="1" Class="h-100 my-2" Style="height:100%; width:100%;">
        <MudItem Class="d-flex" Style="flex:3; min-height:260px;">
            <MudPaper Class="d-flex justify-center align-center pa-2"
                      Style="width:100%; height:100%;">
                <MudTextField Value="@(PrintMessages)"
