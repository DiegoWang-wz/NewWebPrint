                                    <MudDatePicker Label="yyyy-MM-dd" Editable="true" @bind-Date="_date"
                                                   Mask="@(new DateMask("0000-00-00"))" DateFormat="yyyy-MM-dd"
                                                   Placeholder="ISO Date" Variant="Variant.Outlined"/>

                                    <MudSelect T="string"
                                               Label="选择组别"
