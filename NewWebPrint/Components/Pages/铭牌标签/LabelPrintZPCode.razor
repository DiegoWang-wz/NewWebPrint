                                        <MudSelectItem T="string" Value="@("S")">S</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("T")">T</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("U")">U</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("V")">V</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("W")">W</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("X")">X</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Y")">Y</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Z")">Z</MudSelectItem>
                                    </MudSelect>
                                </MudStack>

                                <MudStack Row="true"
                                          Spacing="1"
                                          AlignItems="AlignItems.Center"
                                          Class="mt-1">
                                    <MudText Typo="Typo.subtitle2" Class="mr-2">标签类型:</MudText>

                                    <MudRadioGroup @bind-Value="LabelType" Class="size-radio-group">
                                        <MudStack Row="true" Spacing="1">
                                            <MudRadio Value="@("Barcode")" Color="Color.Primary">条形码</MudRadio>
                                            <MudRadio Value="@("QrCode")" Color="Color.Primary">二维码</MudRadio>
                                            <MudRadio Value="@("NewBarcode")" Color="Color.Primary">条形码新</MudRadio>
                                            <MudRadio Value="@("ApplianceCode")" Color="Color.Primary">电器条码
                                            </MudRadio>
                                        </MudStack>
                                    </MudRadioGroup>
                                </MudStack>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <KeypadTarget TValue="int" Label="打印起始页" @bind-Value="txtContainer_start"/>
                <KeypadTarget TValue="int" Label="打印结束页" @bind-Value="txtContainer_end"/>
                <KeypadTarget TValue="int" Disabled="true" Label="每条记录打印份数" @bind-Value="txtIdenticalCopies"/>

                <MudGrid GutterSize="2" AlignItems="AlignItems.End" Class="my-1">
