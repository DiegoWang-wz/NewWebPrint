                                               Variant="Variant.Outlined"
                                               Dense="true">
                                        <MudSelectItem T="string" Value="@("A")">A</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("B")">B</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("C")">C</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("D")">D</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("E")">E</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("F")">F</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("G")">G</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("H")">H</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("I")">I</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("J")">J</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("K")">K</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("L")">L</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("M")">M</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("N")">N</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("O")">O</MudSelectItem>
