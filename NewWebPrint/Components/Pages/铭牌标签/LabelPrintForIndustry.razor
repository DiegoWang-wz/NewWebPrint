    static string WalwTextAfterPrefix(string? full, string prefixCn, string prefixAscii)
    {
        var s = (full ?? string.Empty).Trim();
        if (s.Length == 0) return string.Empty;
        if (s.StartsWith(prefixCn, StringComparison.Ordinal))
            return s[prefixCn.Length..].Trim();
        if (s.StartsWith(prefixAscii, StringComparison.Ordinal))
            return s[prefixAscii.Length..].Trim();
        return s;
    }

