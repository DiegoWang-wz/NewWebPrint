            SnackbarHelper.Show("请先选择打印机", Severity.Warning);
            return false;
        }

        var (paperOk, w, h) = TryParsePaper(PaperSize);
        if (!paperOk || w <= 0 || h <= 0)
        {
            SnackbarHelper.Show("纸张尺寸格式错误", Severity.Error);
            return false;
        }

        if (PrintCount < 1)
        {
            SnackbarHelper.Show("打印份数无效", Severity.Error);
            return false;
        }

        var layout = new PrintLayoutModel
        {
            PrinterName = SelectedPrinter,
            PaperWidthMm = w,
            PaperHeightMm = h,
            Copies = 1,
            StartValue = 1,
            PrintCount = PrintCount,
            GapMm = null,
            BorderThicknessMm = 0.4f,
            IsRotate = false,
            Blocks = list
        };

        IsPrinting = true;
        var variantTag = SelectedFa42Variant == 0 ? "FA42A-V" : "FA42A-H";
        AppendLog($"发送打印 FA42A（{variantTag}）：{SelectedPrinter}");
        try
        {
            await PrinterHelper.PrintLayoutAsync(JS, layout);
            await PrinterHelper.SaveLastUsedPrinterAsync(JS, SelectedPrinter, "LabelPrintForZY_printer");

            AppendLog("FA42A 铭牌打印提交成功。");
            SnackbarHelper.Show("打印提交成功", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            AppendLog($"FA42A 打印异常：{ex.Message}");
            SnackbarHelper.Show($"异常：{ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            IsPrinting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

