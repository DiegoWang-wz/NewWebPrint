        await PrinterBootstrap.TryLoadOnFirstRenderAsync(
            firstRender,
            "LabelPrintForZY_printer",
            ApplyPrinterLoadResult,
            () => InvokeAsync(StateHasChanged));

        if (firstRender && !_industryUiRestoredFromStorage)
        {
            _industryUiRestoredFromStorage = true;
            await RestoreIndustryUiFromLocalStorageAsync();
        }

        if (firstRender && !_lwUiRestoredFromStorage)
        {
            _lwUiRestoredFromStorage = true;
            await RestoreIndustryMainTabFromStorageAsync();
            await RestoreLwFromLocalStorageAsync();
        }

        if (firstRender && !_fa42UiRestoredFromStorage)
        {
            _fa42UiRestoredFromStorage = true;
            await RestoreFa42FromLocalStorageAsync();
        }

        if (firstRender)
            await InvokeAsync(StateHasChanged);

        if (_focusGeneralInternalBarcodeAfterRender)
        {
            _focusGeneralInternalBarcodeAfterRender = false;
            if (_generalInternalBarcodeField is not null)
                await _generalInternalBarcodeField.FocusAsync();
        }

        if (_focusWaLwInternalBarcodeAfterRender)
        {
            _focusWaLwInternalBarcodeAfterRender = false;
            if (_waLwInternalBarcodeField is not null)
                await _waLwInternalBarcodeField.FocusAsync();
