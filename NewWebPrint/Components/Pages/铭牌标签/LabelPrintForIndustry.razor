    /// <summary>
    /// 规范化内部条码：去掉首尾与中间空白后，仅取<strong>末尾连续 4 个字符</strong>作为序列号（如扫码 <c>FA8-0039</c> 得到 <c>0039</c>），不按分隔符拆分。
    /// 不足 4 个字符时保留原串，便于短码手工录入。
    /// </summary>
    static string? NormalizeInternalBarcodePart(string? raw)
    {
        var s = (raw ?? string.Empty).Trim().Replace(" ", "").Replace("\u3000", "");
        if (s.Length == 0)
            return null;
        return s.Length >= 4 ? s[^4..] : s;
    }


    static string? NormalizeProductionOrder9Digits(string? raw)
    {
        var digits = new string((raw ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length == 0)
            return null;
        if (digits.Length >= 9)
            return digits[^9..];
        return digits.PadLeft(9, '0');
    }

    /// <summary>Serial = 9 位生产订单 + 内部条码。</summary>
    static string? BuildSerialNo(string? productionOrder, string? contentBarcode)
    {
        var order9 = NormalizeProductionOrder9Digits(productionOrder);
        var inner = NormalizeInternalBarcodePart(contentBarcode);
        if (order9 == null || inner == null)
            return null;
        return order9 +'-'+ inner;
    }

    record ScannedLine(string Code, DateTime? ProductionTime);

    (bool ok, float w, float h) TryParsePaper(string paper)
    {
        try
        {
            var parts = (paper ?? "").Split(
                new char[] { '*', 'x', 'X' },
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (parts.Length != 2) return (false, 0, 0);
            return (true, float.Parse(parts[0]), float.Parse(parts[1]));
        }
        catch
        {
            return (false, 0, 0);
        }
    }

