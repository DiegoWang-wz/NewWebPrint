    const string IndustrialCodeBindApiUrl = "http://192.168.3.240:10310/GY_Code/ajaxAddCodeMinimal";

    /// <summary>逐条调用 GY_Code/ajaxAddCodeMinimal，InternalCode + OuterBoxCode；返回 1 为成功。</summary>
    async Task<(bool ok, string? error)> InvokeIndustrialCodeBindApiAsync(
        string logTag,
        string outerBoxBarcode,
        IReadOnlyList<string> internalCodes)
    {
        if (internalCodes.Count == 0)
            return (false, "没有可绑定的内部条码");

        var client = HttpClientFactory.CreateClient();
        client.Timeout = TimeSpan.FromSeconds(30);

        for (var i = 0; i < internalCodes.Count; i++)
        {
            var internalCode = (internalCodes[i] ?? string.Empty).Trim();
            if (string.IsNullOrEmpty(internalCode))
                return (false, $"第 {i + 1} 条内部条码为空");

            using var content = new FormUrlEncodedContent(new Dictionary<string, string>
            {
                ["InternalCode"] = internalCode,
                ["OuterBoxCode"] = outerBoxBarcode,
            });

            HttpResponseMessage response;
            try
            {
                response = await client.PostAsync(IndustrialCodeBindApiUrl, content);
            }
            catch (Exception ex)
            {
                return (false, $"第 {i + 1} 条请求异常（{internalCode}）：{ex.Message}");
            }

            var body = (await response.Content.ReadAsStringAsync()).Trim();
            if (!response.IsSuccessStatusCode)
                return (false, $"第 {i + 1} 条 HTTP {(int)response.StatusCode}（{internalCode}）：{body}");

            if (!IsIndustrialCodeBindApiSuccess(body))
                return (false, $"第 {i + 1} 条绑定失败（{internalCode}）：条码为空或写入异常");

            AppendLog($"{logTag} 绑定 OK [{i + 1}/{internalCodes.Count}]：{internalCode} → {outerBoxBarcode}");
        }

        return (true, null);
    }

    static bool IsIndustrialCodeBindApiSuccess(string? body)
    {
        var t = body?.Trim();
        if (string.IsNullOrEmpty(t))
            return false;
        if (t == "1")
            return true;
        return int.TryParse(t, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) && n == 1;
    }

    async Task PrintSubmitInternalBarcodeAsync()
    {
        var prefix = BuildInternalBarcodePrefixOrNull(InternalBarcodePrefix);
        var pattern = BuildInternalBarcodePrintPattern();
        if (string.IsNullOrEmpty(prefix) || string.IsNullOrEmpty(pattern))
        {
            SnackbarHelper.Show("请先输入条码前缀", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedPrinter))
        {
