    static void RemoveFa17AddressBlocks(List<PrintBlock> list)
    {
        list.RemoveAll(b =>
            string.Equals(b.Name, "address", StringComparison.OrdinalIgnoreCase)
            || string.Equals(b.Name, "Block 13", StringComparison.OrdinalIgnoreCase)
            || (b.Text?.Content?.Equals("Address", StringComparison.OrdinalIgnoreCase) == true)
            || (b.Text?.Content?.Contains("PROVINCIALHIGHTECHPARK", StringComparison.OrdinalIgnoreCase) == true)
            || (b.Text?.Content == ":" && b.X > 15f && b.Y >= 32f));
    }

    static void AppendFa17CertIconBlocks(List<PrintBlock> list, string? pic1, string? pic2, string? pic3, string? pic4)
    {
        void Add(string name, float x, string? b64)
        {
            if (string.IsNullOrEmpty(b64))
                return;
            list.Add(new PrintBlock
            {
                Name = name,
                X = x,
                Y = 33f,
                Width = 5f,
                Height = 5f,
                ShowBorder = false,
                BorderStyle = "Solid",
                Image = new ImageElement
                {
                    Base64 = b64,
                    FilePath = "",
                    Fit = "contain",
                    Align = "center",
                    VerticalAlign = "middle",
                    Opacity = 1f
                },
            });
        }

        Add("img1", 10f, pic1);
        Add("img2", 20f, pic2);
        Add("img3", 30f, pic3);
        Add("img4", 40f, pic4);
    }

