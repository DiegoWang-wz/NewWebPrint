    async Task PrintSubmit()
    {
        if (IsPrinting) return;

        if (IndustryMainTab == 1 || IndustryMainTab == 2)
            return;

        if (IndustryMainTab == 3)
            return;

        if (IndustryMainTab == 4)
        {
            await PrintSubmitInternalBarcodeAsync();
            return;
        }

        if (NormalizeProductionOrder9Digits(ProductionOrder) == null)
        {
            SnackbarHelper.Show("生产订单号中需包含数字，以组成 Serial 前 9 位", Severity.Warning);
            return;
        }

        if (NormalizeInternalBarcodePart(ContentBarcode) == null)
        {
            SnackbarHelper.Show("请输入内部条码（内部条码）", Severity.Warning);
            return;
        }

        var serial = BuildSerialNo(ProductionOrder, ContentBarcode);
        if (string.IsNullOrEmpty(serial))
        {
            SnackbarHelper.Show("无法组成 Serial（生产订单 + 内部条码）", Severity.Warning);
            return;
        }

        List<PrintBlock> list = new List<PrintBlock>();

        if (SelectedLabelKind == 0)
        {
            PaperSize = "55*40";
            list = BarCode55x40();
        }
        else if (SelectedLabelKind == 1)
        {
            PaperSize = "55*40";
            list = QrCode55x40();
        }
        else if (SelectedLabelKind == 2)
        {
            PaperSize = "40*25";
            list = BarCode40x25();
        }
        else if (SelectedLabelKind == 3)
        {
            PaperSize = "40*25";
            list = QrCode40x25();
        }


        if (string.IsNullOrWhiteSpace(SelectedPrinter))
        {
            SnackbarHelper.Show("请先选择打印机", Severity.Warning);
            return;
        }

        var (paperOk, w, h) = TryParsePaper(PaperSize);
        if (!paperOk || w <= 0 || h <= 0)
        {
            SnackbarHelper.Show("纸张尺寸格式错误（如 100*80）", Severity.Error);
            return;
        }

        if (PrintCount < 1)
        {
            SnackbarHelper.Show("打印份数无效", Severity.Error);
            return;
        }


        var layout = new PrintLayoutModel
        {
            PrinterName = SelectedPrinter,
            PaperWidthMm = w,
            PaperHeightMm = h,
            Copies = 1,
            StartValue = 1,
            PrintCount = PrintCount,
            GapMm = null,
            BorderThicknessMm = 0.4f,
            IsRotate = false,
            Blocks = list
        };

        IsPrinting = true;
        AppendLog($"发送打印：{SelectedPrinter}");
        try
        {
            await PrinterHelper.PrintLayoutAsync(JS, layout);
            await PrinterHelper.SaveLastUsedPrinterAsync(JS, SelectedPrinter, "LabelPrintForZY_printer");

            AppendLog("打印提交成功。");
            SnackbarHelper.Show("打印提交成功", Severity.Success);
            ContentBarcode = string.Empty;
            _generalInternalBarcodeFieldKey++;
            _focusGeneralInternalBarcodeAfterRender = true;
        }
        catch (Exception ex)
        {
            AppendLog($"异常：{ex.Message}");
            SnackbarHelper.Show($"异常：{ex.Message}", Severity.Error);
        }
        finally
        {
            IsPrinting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>W*A-LW：扫内部条码 → 打印铭牌 → 记入待绑定列表；满箱后绑定外箱。</summary>
    async Task HandleWaLwInternalBarcodeScanAsync()
    {
        var code = (LwInternalBarcode ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(code))
        {
            LwInternalBarcode = string.Empty;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (NormalizeInternalBarcodePart(code) == null)
        {
            SnackbarHelper.Show("内部条码格式无效", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(LwBatch))
        {
            SnackbarHelper.Show("请填写批次(当月)", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(LwCustomerPrefix))
        {
            SnackbarHelper.Show("请填写客户前缀", Severity.Warning);
            return;
        }

        var duplicateIndex = WaLwScannedLines.FindIndex(x =>
            string.Equals(x.InternalBarcode, code, StringComparison.OrdinalIgnoreCase));
        if (duplicateIndex >= 0)
        {
            SnackbarHelper.Show($"条码重码：与序号 {duplicateIndex + 1} 重复", Severity.Warning);
            AppendLog($"W*A-LW 重码拦截：{code}，与序号 {duplicateIndex + 1} 重复。");
            LwInternalBarcode = string.Empty;
