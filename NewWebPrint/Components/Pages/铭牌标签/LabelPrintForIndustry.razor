@page "/LabelPrintForIndustry"
@inject SnackbarHelper SnackbarHelper
@using System.Globalization
@using NewWebPrint.Utilities
@using Microsoft.Data.SqlClient

@rendermode InteractiveServer
@inject LocalStorageHelper LocalStorage
@inject LocalAgentPrinterBootstrap PrinterBootstrap
@inject IHttpClientFactory HttpClientFactory

<MudGrid Class="pa-4 py-3 side-mark-page industry-label-page"
         GutterSize="2"
         Justify="Justify.Center"
         AlignItems="AlignItems.Start">
    <MudItem xs="12" xl="12">
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-0 pt-2"
                 Class="industry-nameplate-tabs mb-2" @bind-ActivePanelIndex="IndustryMainTab">
            <MudTabPanel Text="通用铭牌">
        <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Stretch">
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="生产订单号" @bind-Value="ProductionOrder"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @ref="_generalInternalBarcodeField"
                                          @bind-Value="ContentBarcode"
                                          @key="_generalInternalBarcodeFieldKey"
                                          Label="内部条码"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Class="barcode-entry-field"
                                          Immediate="true"
                                          Placeholder="扫码录入，回车直接打印"
                                          OnKeyUp="OnGeneralInternalBarcodeKeyUp"/>
                        </MudItem>
                        <MudItem xs="12">
                            <div class="result-list-grid industry-plate-grid">
                                <div class="result-list-item industry-plate-field">
                                    <span class="result-list-label">Type</span>
                                    <MudTextField T="string" Value="@PlateType" ValueChanged="@OnPlateTypeChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                  Class="plate-inline-input"/>
                                </div>
                                <div class="result-list-item industry-plate-field">
                                    <span class="result-list-label">Item No</span>
                                    <MudTextField T="string" Value="@PlateItemNo" ValueChanged="@OnPlateItemNoChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                  Class="plate-inline-input"/>
                                </div>
                                <div class="result-list-item industry-plate-field">
                                    <span class="result-list-label">Power Rate</span>
                                    <MudTextField T="string" Value="@PlatePowerRate" ValueChanged="@OnPlatePowerRateChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                  Class="plate-inline-input"/>
                                </div>
                                <div class="result-list-item industry-plate-field">
                                    <span class="result-list-label">Rated.Load</span>
                                    <MudTextField T="string" Value="@PlateRatedLoad" ValueChanged="@OnPlateRatedLoadChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                  Class="plate-inline-input"/>
                                </div>
                                <div class="result-list-item industry-plate-field">
                                    <span class="result-list-label">Duty Cycle</span>
                                    <MudTextField T="string" Value="@PlateDutyCycle" ValueChanged="@OnPlateDutyCycleChanged"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                  Class="plate-inline-input"/>
                                </div>
                                <div class="result-list-item industry-plate-field">
                                    <span class="result-list-label">Serial No</span>
                                    <MudTextField T="string" Value="@DisplayDash(ResolvedSerialNo)" ReadOnly="true"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                                  FullWidth="true" TabIndex="-1"
                                                  Class="plate-inline-input plate-serial-readonly font-monospace"/>
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <MudRadioGroup Value="SelectedLabelKind" ValueChanged="@OnLabelKindChanged" T="int">
                                <div class="label-kind-radio-grid">
                                    <MudRadio Value="@(0)" Color="Color.Primary">条形码标签55*40</MudRadio>
                                    <MudRadio Value="@(1)" Color="Color.Primary">二维码标签55*40</MudRadio>
                                    <MudRadio Value="@(2)" Color="Color.Primary">条形码标签40*25</MudRadio>
                                    <MudRadio Value="@(3)" Color="Color.Primary">二维码标签40*25</MudRadio>
                                </div>
                            </MudRadioGroup>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSelect T="string" Label="请选择打印机" Value="SelectedPrinter" ValueChanged="@OnPrinterChanged"
                                       Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var p in Printers)
                                {
                                    <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="PrintCount" Label="打印份数"
                                             Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                           Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="PrintSubmit"
                                       Disabled="@IsPrinting" FullWidth="true" Class="action-btn">
                                @(IsPrinting ? "打印中…" : "直接打印")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="W*A-LW铭牌">
                <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Stretch">
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@LwName" ValueChanged="@OnLwNameChanged"
                                                  Label="名称" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@LwDrawing" ValueChanged="@OnLwDrawingChanged"
                                                  Label="图号" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@LwSupplierCode" ValueChanged="@OnLwSupplierCodeChanged"
                                                  Label="供应商代码" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@LwSupplierProduct" ValueChanged="@OnLwSupplierProductChanged"
                                                  Label="供应商产品代码" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@LwCustomerPrefix" ValueChanged="@OnLwCustomerPrefixChanged"
                                                  Label="客户前缀" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@LwMonthMm" ReadOnly="true"
                                                  Label="月份(MM)" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@LwBatch" ValueChanged="@OnLwBatchChanged"
                                                  Label="批次(当月)" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@LwTail4Display" ReadOnly="true"
                                                  Label="条码尾号" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  Class="plate-serial-readonly font-monospace"/>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField T="string"
                                                  @ref="_waLwInternalBarcodeField"
                                                  @key="_waLwInternalBarcodeFieldKey"
                                                  Value="@LwInternalBarcode" ValueChanged="@OnLwInternalBarcodeChanged"
                                                  Label="内部条码"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="barcode-entry-field"
                                                  Immediate="true"
                                                  Placeholder="扫码录入，回车直接打印"
                                                  OnKeyUp="OnWaLwInternalBarcodeKeyUp"/>
                                </MudItem>
                                <MudItem xs="12" sm="5">
                                    <MudTextField T="string" Value="@LwCompositeDisplay()" ReadOnly="true" Disabled="true"
                                                  Label="客户标识" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  TabIndex="-1"
                                                  Class="lw-composite-readonly font-monospace"/>
                                </MudItem>
                                <MudItem xs="12" sm="3" Class="d-flex align-center" Style="min-height: 48px;">
                                    <MudCheckBox T="bool" Dense="true"
                                                 Value="LwShowCertificationIcons"
                                                 ValueChanged="OnLwShowCertIconsChanged"
                                                 Label="打印图标"/>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudTextField T="string" Value="@WaLwOuterBoxBarcode" ValueChanged="@OnWaLwOuterBoxBarcodeChanged"
                                                  Label="外箱条码"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="font-monospace barcode-entry-field"
                                                  Immediate="true"
                                                  Placeholder="扫描或输入外箱条码"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" Value="WaLwFullBoxCount" ValueChanged="OnWaLwFullBoxCountChanged"
                                                     Label="满箱数" Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@WaLwScannedCountDisplay" ReadOnly="true"
                                                  Label="当前已扫入" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  Class="plate-serial-readonly font-monospace"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudRadioGroup Value="SelectedLwVariant" ValueChanged="@OnLwVariantChanged" T="int">
                                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                            <MudRadio Value="@(0)" Color="Color.Primary">W1A-LW</MudRadio>
                                            <MudRadio Value="@(1)" Color="Color.Primary">W8A-LW</MudRadio>
                                        </MudStack>
                                    </MudRadioGroup>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect T="string" Label="请选择打印机" Value="SelectedPrinter" ValueChanged="@OnPrinterChanged"
                                               Margin="Margin.Dense" Variant="Variant.Outlined">
                                        @foreach (var p in Printers)
                                        {
                                            <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="PrintCount" Label="打印份数"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                                   Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="BindWaLwOuterBoxManualAsync"
                                               Disabled="@(!CanBindWaLwOuterBox)"
                                               FullWidth="true" Class="action-btn">
                                        @(IsBindingWaLw ? "绑定中…" : "保存绑定")
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <MudPaper Outlined="true" Class="pa-3 fa17-bottom-panel">
                            <MudText Typo="Typo.subtitle2" Class="mb-1 fa17-bottom-panel-title">已扫内部条码</MudText>
                            <div class="scan-table-wrap fa17-bottom-panel-body">
                                <MudTable Items="@WaLwScanRows" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                                    <HeaderContent>
                                        <MudTh Style="width: 80px;">序号</MudTh>
                                        <MudTh>内部条码</MudTh>
                                        <MudTh Style="min-width: 140px;">扫入时间</MudTh>
                                        <MudTh Style="width: 90px;">操作</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Index</MudTd>
                                        <MudTd Class="font-monospace">@context.InternalBarcode</MudTd>
                                        <MudTd Class="text-no-wrap">@context.ScannedAt.ToString("HH:mm:ss")</MudTd>
                                        <MudTd>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveWaLwScannedLine(context.Index - 1))">
                                                删除
                                            </MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="260" Class="fa17-bottom-panel w-100"/>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="FA42A铭牌">
                <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Stretch">
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa42Name" ValueChanged="@OnFa42NameChanged"
                                                  Label="名称" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa42Drawing" ValueChanged="@OnFa42DrawingChanged"
                                                  Label="图号" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa42SupplierCode" ValueChanged="@OnFa42SupplierCodeChanged"
                                                  Label="供应商代码" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa42SupplierProduct" ValueChanged="@OnFa42SupplierProductChanged"
                                                  Label="供应商产品代码" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@Fa42CustomerPrefix" ValueChanged="@OnFa42CustomerPrefixChanged"
                                                  Label="客户前缀" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@Fa42MonthMm" ReadOnly="true"
                                                  Label="月份(MM)" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@Fa42Batch" ValueChanged="@OnFa42BatchChanged"
                                                  Label="批次(当月)" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudTextField T="string" Value="@Fa42Tail4Display" ReadOnly="true"
                                                  Label="条码尾号" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  Class="plate-serial-readonly font-monospace"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  @ref="_fa42InternalBarcodeField"
                                                  @key="_fa42InternalBarcodeFieldKey"
                                                  Value="@Fa42InternalBarcode" ValueChanged="@OnFa42InternalBarcodeChanged"
                                                  Label="内部条码"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="barcode-entry-field"
                                                  Immediate="true"
                                                  Placeholder="扫码录入，回车直接打印"
                                                  OnKeyUp="OnFa42InternalBarcodeKeyUp"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa42CompositeDisplay()" ReadOnly="true" Disabled="true"
                                                  Label="客户标识" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  TabIndex="-1"
                                                  Class="lw-composite-readonly font-monospace"/>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudTextField T="string" Value="@Fa42OuterBoxBarcode" ValueChanged="@OnFa42OuterBoxBarcodeChanged"
                                                  Label="外箱条码"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="font-monospace barcode-entry-field"
                                                  Immediate="true"
                                                  Placeholder="扫描或输入外箱条码"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" Value="Fa42FullBoxCount" ValueChanged="OnFa42FullBoxCountChanged"
                                                     Label="满箱数" Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa42ScannedCountDisplay" ReadOnly="true"
                                                  Label="当前已扫入" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  Class="plate-serial-readonly font-monospace"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudRadioGroup Value="SelectedFa42Variant" ValueChanged="@OnFa42VariantChanged" T="int">
                                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                            <MudRadio Value="@(0)" Color="Color.Primary">FA42A-V</MudRadio>
                                            <MudRadio Value="@(1)" Color="Color.Primary">FA42A-H</MudRadio>
                                        </MudStack>
                                    </MudRadioGroup>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect T="string" Label="请选择打印机" Value="SelectedPrinter" ValueChanged="@OnPrinterChanged"
                                               Margin="Margin.Dense" Variant="Variant.Outlined">
                                        @foreach (var p in Printers)
                                        {
                                            <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="PrintCount" Label="打印份数"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                                   Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="BindFa42OuterBoxManualAsync"
                                               Disabled="@(!CanBindFa42OuterBox)"
                                               FullWidth="true" Class="action-btn">
                                        @(IsBindingFa42 ? "绑定中…" : "保存绑定")
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <MudPaper Outlined="true" Class="pa-3 fa17-bottom-panel">
                            <MudText Typo="Typo.subtitle2" Class="mb-1 fa17-bottom-panel-title">已扫内部条码</MudText>
                            <div class="scan-table-wrap fa17-bottom-panel-body">
                                <MudTable Items="@Fa42ScanRows" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                                    <HeaderContent>
                                        <MudTh Style="width: 80px;">序号</MudTh>
                                        <MudTh>内部条码</MudTh>
                                        <MudTh Style="min-width: 140px;">扫入时间</MudTh>
                                        <MudTh Style="width: 90px;">操作</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Index</MudTd>
                                        <MudTd Class="font-monospace">@context.InternalBarcode</MudTd>
                                        <MudTd Class="text-no-wrap">@context.ScannedAt.ToString("HH:mm:ss")</MudTd>
                                        <MudTd>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveFa42ScannedLine(context.Index - 1))">
                                                删除
                                            </MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="260" Class="fa17-bottom-panel w-100"/>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="FA17标签打印">
                <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Stretch">
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Label="生产订单号" @bind-Value="ProductionOrder"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @ref="_fa17InternalBarcodeField"
                                                  @bind-Value="ContentBarcode"
                                                  @key="_fa17InternalBarcodeFieldKey"
                                                  Label="内部条码"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="barcode-entry-field"
                                                  Immediate="true"
                                                  Placeholder="扫码录入，回车直接打印"
                                                  OnKeyUp="OnFa17InternalBarcodeKeyUp"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="result-list-grid industry-plate-grid">
                                        <div class="result-list-item industry-plate-field">
                                            <span class="result-list-label">Type</span>
                                            <MudTextField T="string" Value="@PlateType" ValueChanged="@OnPlateTypeChanged"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                          Class="plate-inline-input"/>
                                        </div>
                                        <div class="result-list-item industry-plate-field">
                                            <span class="result-list-label">Item No</span>
                                            <MudTextField T="string" Value="@PlateItemNo" ValueChanged="@OnPlateItemNoChanged"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                          Class="plate-inline-input"/>
                                        </div>
                                        <div class="result-list-item industry-plate-field">
                                            <span class="result-list-label">Power Rate</span>
                                            <MudTextField T="string" Value="@PlatePowerRate" ValueChanged="@OnPlatePowerRateChanged"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                          Class="plate-inline-input"/>
                                        </div>
                                        <div class="result-list-item industry-plate-field">
                                            <span class="result-list-label">Rated.Load</span>
                                            <MudTextField T="string" Value="@PlateRatedLoad" ValueChanged="@OnPlateRatedLoadChanged"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                          Class="plate-inline-input"/>
                                        </div>
                                        <div class="result-list-item industry-plate-field">
                                            <span class="result-list-label">Duty Cycle</span>
                                            <MudTextField T="string" Value="@PlateDutyCycle" ValueChanged="@OnPlateDutyCycleChanged"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                          Class="plate-inline-input"/>
                                        </div>
                                        <div class="result-list-item industry-plate-field">
                                            <span class="result-list-label">Serial No</span>
                                            <MudTextField T="string" Value="@DisplayDash(ResolvedSerialNo)" ReadOnly="true"
                                                          Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                                          FullWidth="true" TabIndex="-1"
                                                          Class="plate-inline-input plate-serial-readonly font-monospace"/>
                                        </div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex">
                        <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel w-100">
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudTextField T="string" Value="@Fa17OuterBoxBarcode" ValueChanged="@OnFa17OuterBoxBarcodeChanged"
                                                  Label="外箱条码"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="font-monospace barcode-entry-field"
                                                  Immediate="true"
                                                  Placeholder="扫描或输入外箱条码"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" Value="Fa17FullBoxCount" ValueChanged="OnFa17FullBoxCountChanged"
                                                     Label="满箱数" Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="@Fa17ScannedCountDisplay" ReadOnly="true"
                                                  Label="当前已扫入" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                  Class="plate-serial-readonly font-monospace"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudRadioGroup Value="SelectedFa17LabelKind" ValueChanged="@OnFa17LabelKindChanged" T="int">
                                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                            <MudRadio Value="@(0)" Color="Color.Primary">条形码标签55*40</MudRadio>
                                            <MudRadio Value="@(1)" Color="Color.Primary">二维码标签55*40</MudRadio>
                                        </MudStack>
                                    </MudRadioGroup>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect T="string" Label="请选择打印机" Value="SelectedPrinter" ValueChanged="@OnPrinterChanged"
                                               Margin="Margin.Dense" Variant="Variant.Outlined">
                                        @foreach (var p in Printers)
                                        {
                                            <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="PrintCount" Label="打印份数"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" Min="1"/>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                                   Variant="Variant.Outlined"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="BindFa17OuterBoxManualAsync"
                                               Disabled="@(!CanBindFa17OuterBox)"
                                               FullWidth="true" Class="action-btn">
                                        @(IsBindingFa17 ? "绑定中…" : "保存绑定")
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <MudPaper Outlined="true" Class="pa-3 fa17-bottom-panel">
                            <MudText Typo="Typo.subtitle2" Class="mb-1 fa17-bottom-panel-title">已扫内部条码</MudText>
                            <div class="scan-table-wrap fa17-bottom-panel-body">
                                <MudTable Items="@Fa17ScanRows" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                                    <HeaderContent>
                                        <MudTh Style="width: 80px;">序号</MudTh>
                                        <MudTh>内部条码</MudTh>
                                        <MudTh Style="min-width: 140px;">扫入时间</MudTh>
                                        <MudTh Style="width: 90px;">操作</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Index</MudTd>
                                        <MudTd Class="font-monospace">@context.InternalBarcode</MudTd>
                                        <MudTd Class="text-no-wrap">@context.ScannedAt.ToString("HH:mm:ss")</MudTd>
                                        <MudTd>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveFa17ScannedLine(context.Index - 1))">
                                                删除
                                            </MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="260" Class="fa17-bottom-panel w-100"/>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="内部条码">
                <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Stretch">
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <MudPaper Outlined="true" Class="pa-3 fa17-bottom-panel d-flex flex-column">
                            <MudTextField T="string" Value="@InternalBarcodePrefix" ValueChanged="@OnInternalBarcodePrefixChanged"
                                          Label="条码前缀"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Class="font-monospace"
                                          Immediate="true"
                                          Placeholder="例如 xxxxxx"/>
                            <MudNumericField @bind-Value="PrintCount" Label="打印份数"
                                             Margin="Margin.Dense" Variant="Variant.Outlined" Min="1" Class="mt-2"/>
                            <MudSelect T="string" Label="请选择打印机" Value="SelectedPrinter" ValueChanged="@OnPrinterChanged"
                                       Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2">
                                @foreach (var p in Printers)
                                {
                                    <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                }
                            </MudSelect>
                            <div class="mt-auto pt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="PrintSubmit"
                                           Disabled="@IsPrinting" FullWidth="true" Class="action-btn">
                                    @(IsPrinting ? "打印中…" : "打印")
                                </MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="fa17-bottom-col">
                        <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="260" Class="fa17-bottom-panel w-100"/>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>

        @if (IndustryMainTab is 0)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="200"/>
                </MudItem>
            </MudGrid>
        }
    </MudItem>
</MudGrid>


@code {
    List<string> Printers { get; set; } = new();
    string? DefaultPrinter { get; set; }
    string? SelectedPrinter { get; set; }
    string ProductionOrder { get; set; } = string.Empty;
    bool IsPrinting { get; set; }
    string PrintMessages { get; set; } = string.Empty;
    string PaperSize { get; set; } = "100*80";
    DateTime? ProductionDate { get; set; } = DateTime.Today;
    int PrintCount = 1;
    int SelectedLabelKind { get; set; }
    /// <summary>FA17：0 条形码 55*40，1 二维码 55*40。</summary>
    int SelectedFa17LabelKind { get; set; }
    string? Fa17OuterBoxBarcode { get; set; }
    int Fa17FullBoxCount { get; set; } = 10;
    readonly List<Fa17ScannedLine> Fa17ScannedLines = new();
    bool IsBindingFa17 { get; set; }
    string Fa17ScannedCountDisplay => $"{Fa17ScannedLines.Count} / {Fa17FullBoxCount}";
    bool CanBindFa17OuterBox =>
        !IsBindingFa17
        && Fa17ScannedLines.Count >= Fa17FullBoxCount
        && !string.IsNullOrWhiteSpace(Fa17OuterBoxBarcode);
    List<Fa17ScanRow> Fa17ScanRows => Fa17ScannedLines
        .Select((line, index) => new Fa17ScanRow(index + 1, line.InternalBarcode, line.ScannedAt))
        .ToList();
    string? WaLwOuterBoxBarcode { get; set; }
    int WaLwFullBoxCount { get; set; } = 10;
    readonly List<WaLwScannedLine> WaLwScannedLines = new();
    bool IsBindingWaLw { get; set; }
    string WaLwScannedCountDisplay => $"{WaLwScannedLines.Count} / {WaLwFullBoxCount}";
    bool CanBindWaLwOuterBox =>
        !IsBindingWaLw
        && WaLwScannedLines.Count >= WaLwFullBoxCount
        && !string.IsNullOrWhiteSpace(WaLwOuterBoxBarcode);
    List<WaLwScanRow> WaLwScanRows => WaLwScannedLines
        .Select((line, index) => new WaLwScanRow(index + 1, line.InternalBarcode, line.ScannedAt))
        .ToList();
    string? Fa42OuterBoxBarcode { get; set; }
    int Fa42FullBoxCount { get; set; } = 10;
    readonly List<Fa42ScannedLine> Fa42ScannedLines = new();
    bool IsBindingFa42 { get; set; }
    string Fa42ScannedCountDisplay => $"{Fa42ScannedLines.Count} / {Fa42FullBoxCount}";
    bool CanBindFa42OuterBox =>
        !IsBindingFa42
        && Fa42ScannedLines.Count >= Fa42FullBoxCount
        && !string.IsNullOrWhiteSpace(Fa42OuterBoxBarcode);
    List<Fa42ScanRow> Fa42ScanRows => Fa42ScannedLines
        .Select((line, index) => new Fa42ScanRow(index + 1, line.InternalBarcode, line.ScannedAt))
        .ToList();
    string? InternalBarcodePrefix { get; set; }
    /// <summary>预览：首张条码（滚码由打印引擎按 StartValue=1、PrintCount 生成）。</summary>
    string InternalBarcodePreviewDisplay =>
        BuildInternalBarcodePrefixOrNull(InternalBarcodePrefix) is { } p ? $"{p}-0001" : "-";
    string InternalBarcodeRollRangeDisplay =>
        PrintCount < 1 ? "-" : $"0001 ~ {PrintCount:D4}";
    int _industryMainTab;
    /// <summary>0 通用铭牌，1 W*A-LW，2 FA42A，3 FA17，4 内部条码。</summary>
    int IndustryMainTab
    {
        get => _industryMainTab;
        set
        {
            if (_industryMainTab == value) return;
            var prev = _industryMainTab;
            _industryMainTab = value;
            _ = PersistIndustryMainTabAsync();
            if ((value == 1 || value == 2) && prev != value)
                ProductionDate = DateTime.Today;
        }
    }
    /// <summary>0 W1A-LW，1 W8A-LW。</summary>
    int SelectedLwVariant { get; set; }
    /// <summary>是否在标签右上角打印 CE、WEEE 图（img1/img2）；各型号独立记忆，W8A 默认关。</summary>
    bool LwShowCertificationIcons { get; set; } = true;
    string? LwName { get; set; } = "电动推杆";
    string? LwDrawing { get; set; } = "GKV2803010011";
    string? LwSupplierCode { get; set; } = "B12712";
    string? LwCustomerPrefix { get; set; } = "3ACET";
    string? LwSupplierProduct { get; set; } = "201190540";
    string? LwBatch { get; set; } = "1";
    /// <summary>W*A-LW 专用内部条码（不入库 localStorage；打印成功后清空）。</summary>
    string? LwInternalBarcode { get; set; }
    /// <summary>0 FA42A-V，1 FA42A-H。</summary>
    int SelectedFa42Variant { get; set; }
    string? Fa42Name { get; set; } = "电动推杆";
    string? Fa42Drawing { get; set; } = "CE4P1814020002";
    string? Fa42SupplierCode { get; set; } = "B12712";
    string? Fa42CustomerPrefix { get; set; } = "3ACET";
    string? Fa42SupplierProduct { get; set; } = "201665289";
    string? Fa42Batch { get; set; } = "1";
    string? Fa42InternalBarcode { get; set; }
    string? PlateType { get; set; } = "JC35W8";
    string? PlateItemNo { get; set; } = "xxxxxxxxxxxx";
    string? PlatePowerRate { get; set; } = "24Vdc / 1.5A";
    string? PlateRatedLoad { get; set; } = "500N";
    string? PlateDutyCycle { get; set; } = "20%Max,4min/16min";
    string? ContentBarcode { get; set; }
    string? ResolvedSerialNo => BuildSerialNo(ProductionOrder, ContentBarcode);
    static string DisplayDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value!;

    /// <summary>W*A-LW 只读「月份(MM)」与客户标识中的月份：与「生产日期」同一月份，便于与打印内容一致。</summary>
    string LwMonthMm =>
        (ProductionDate ?? DateTime.Today).ToString("MM", CultureInfo.InvariantCulture);

    string LwTail4Display =>
        NormalizeInternalBarcodePart(LwInternalBarcode) == null ? "-" : LwTail4FromBarcode(LwInternalBarcode);

    static string LwTail4FromBarcode(string? raw)
    {
        var inner = NormalizeInternalBarcodePart(raw);
        if (string.IsNullOrEmpty(inner))
            return "----";
        return inner.Length >= 4 ? inner[^4..] : inner.PadLeft(4, '0');
    }

    string LwCompositeDisplay()
    {
        var innerOk = NormalizeInternalBarcodePart(LwInternalBarcode) != null;
        var p = LwCustomerPrefix?.Trim() ?? "";
        var b = LwBatch?.Trim() ?? "";
        var tail = innerOk ? LwTail4FromBarcode(LwInternalBarcode!) : "----";
        return $"{p}{LwMonthMm}{b}{tail}";
    }

    /// <summary>W*A-LW 二维码：供应商代码*客户标识*供应商产品代码。</summary>
    string LwQrCodeValue() =>
        $"{LwSupplierCode?.Trim() ?? ""}*{LwCompositeDisplay()}*{LwSupplierProduct?.Trim() ?? ""}";

    string Fa42MonthMm =>
        (ProductionDate ?? DateTime.Today).ToString("MM", CultureInfo.InvariantCulture);

    string Fa42Tail4Display =>
        NormalizeInternalBarcodePart(Fa42InternalBarcode) == null ? "-" : LwTail4FromBarcode(Fa42InternalBarcode);

    string Fa42CompositeDisplay()
    {
        var innerOk = NormalizeInternalBarcodePart(Fa42InternalBarcode) != null;
        var p = Fa42CustomerPrefix?.Trim() ?? "";
        var b = Fa42Batch?.Trim() ?? "";
        var tail = innerOk ? LwTail4FromBarcode(Fa42InternalBarcode!) : "----";
        return $"{p}{Fa42MonthMm}{b}{tail}";
    }

    string Fa42QrCodeValue() =>
        $"{Fa42SupplierCode?.Trim() ?? ""}*{Fa42CompositeDisplay()}*{Fa42SupplierProduct?.Trim() ?? ""}";

    static string Fa42BundleStorageKey(int variant, string field) =>
        $"labelIndustry.fa42V{variant}.{field}";

    readonly record struct Fa42VariantDefaults(
        string Name,
        string Drawing,
        string SupplierCode,
        string CustomerPrefix,
        string SupplierProduct,
        string Batch);

    static Fa42VariantDefaults Fa42DefaultsForVariant(int variant) =>
        variant == 0
            ? new Fa42VariantDefaults("电动推杆", "CE4P1814020002", "B12712", "3ACET", "201665289", "1")
            : new Fa42VariantDefaults("电动推杆", "CE4P1814020002a", "B12712", "3ACET", "201751297", "1");

    static string LwBundleStorageKey(int variant, string field) =>
        $"labelIndustry.lwV{variant}.{field}";

    readonly record struct LwVariantDefaults(
        string Name,
        string Drawing,
        string SupplierCode,
        string CustomerPrefix,
        string SupplierProduct,
        string Batch,
        bool ShowCertIcons);

    static LwVariantDefaults LwDefaultsForVariant(int variant) =>
        variant == 0
            ? new LwVariantDefaults("电动推杆", "GKV2803010011", "B12712", "3ACET", "201190540", "1", true)
            : new LwVariantDefaults("四驱电动推杆", "HAV1806350007", "B12712", "3ACET", "201663543", "3", false);

    string FormatPlateDate() =>
        ProductionDate.HasValue
            ? ProductionDate.Value.ToString("yyyy.MM.dd", System.Globalization.CultureInfo.InvariantCulture)
            : "-";

    bool _suppressIndustryPersist;
    bool _industryUiRestoredFromStorage;
    bool _suppressLwPersist;
    bool _lwUiRestoredFromStorage;
    bool _suppressFa42Persist;
    bool _fa42UiRestoredFromStorage;
    /// <summary>递增后 MudTextField 重建，确保打印成功后内部条码框真正清空（Mud 受控输入偶发不同步）。</summary>
    int _generalInternalBarcodeFieldKey;
    int _waLwInternalBarcodeFieldKey;
    int _fa42InternalBarcodeFieldKey;
    int _fa17InternalBarcodeFieldKey;
    MudTextField<string>? _generalInternalBarcodeField;
    MudTextField<string>? _waLwInternalBarcodeField;
    MudTextField<string>? _fa42InternalBarcodeField;
    MudTextField<string>? _fa17InternalBarcodeField;
    bool _focusGeneralInternalBarcodeAfterRender;
    bool _focusWaLwInternalBarcodeAfterRender;
    bool _focusFa42InternalBarcodeAfterRender;
    bool _focusFa17InternalBarcodeAfterRender;

    async Task PersistIndustryUiAsync()
    {
        if (_suppressIndustryPersist)
            return;
        try
        {
            await LocalStorage.SetAsync(StorageKeys.IndustryPlateType, PlateType ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryPlateItemNo, PlateItemNo ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryPlatePowerRate, PlatePowerRate ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryPlateRatedLoad, PlateRatedLoad ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryPlateDutyCycle, PlateDutyCycle ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryLabelKind,
                SelectedLabelKind.ToString(System.Globalization.CultureInfo.InvariantCulture));
            await LocalStorage.SetAsync(StorageKeys.IndustryFa17LabelKind,
                SelectedFa17LabelKind.ToString(CultureInfo.InvariantCulture));
            await LocalStorage.SetAsync(StorageKeys.IndustryFa17FullBoxCount,
                Fa17FullBoxCount.ToString(CultureInfo.InvariantCulture));
            await LocalStorage.SetAsync(StorageKeys.IndustryFa17OuterBoxBarcode, Fa17OuterBoxBarcode ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryWaLwFullBoxCount,
                WaLwFullBoxCount.ToString(CultureInfo.InvariantCulture));
            await LocalStorage.SetAsync(StorageKeys.IndustryWaLwOuterBoxBarcode, WaLwOuterBoxBarcode ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryFa42FullBoxCount,
                Fa42FullBoxCount.ToString(CultureInfo.InvariantCulture));
            await LocalStorage.SetAsync(StorageKeys.IndustryFa42OuterBoxBarcode, Fa42OuterBoxBarcode ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustryInternalBarcodePrefix, InternalBarcodePrefix ?? "");
            await LocalStorage.SetAsync(StorageKeys.IndustrySelectedPrinter, SelectedPrinter ?? "");
        }
        catch
        {
            /* 浏览器存储不可用时不阻断操作 */
        }
    }

    async Task RestoreIndustryUiFromLocalStorageAsync()
    {
        _suppressIndustryPersist = true;
        try
        {
            PlateType = await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryPlateType, "JC35W8");
            PlateItemNo = await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryPlateItemNo, "xxxxxxxxxxxx");
            PlatePowerRate = await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryPlatePowerRate, "24Vdc / 1.5A");
            PlateRatedLoad = await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryPlateRatedLoad, "500N");
            PlateDutyCycle =
                await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryPlateDutyCycle, "20%Max,4min/16min");

            if (await LocalStorage.ContainsKeyAsync(StorageKeys.IndustryLabelKind))
            {
                var kindStr = await LocalStorage.GetStringAsync(StorageKeys.IndustryLabelKind);
                if (int.TryParse(kindStr, out var k) && k is >= 0 and <= 3)
                    SelectedLabelKind = k;
            }

            if (await LocalStorage.ContainsKeyAsync(StorageKeys.IndustryFa17LabelKind))
            {
                var fa17Kind = await LocalStorage.GetStringAsync(StorageKeys.IndustryFa17LabelKind);
                if (int.TryParse(fa17Kind, out var fk) && fk is 0 or 1)
                    SelectedFa17LabelKind = fk;
            }

            if (await LocalStorage.ContainsKeyAsync(StorageKeys.IndustryFa17FullBoxCount))
            {
                var fullBox = await LocalStorage.GetStringAsync(StorageKeys.IndustryFa17FullBoxCount);
                if (int.TryParse(fullBox, out var fc) && fc >= 1)
                    Fa17FullBoxCount = fc;
            }

            Fa17OuterBoxBarcode =
                await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryFa17OuterBoxBarcode, "");

            if (await LocalStorage.ContainsKeyAsync(StorageKeys.IndustryWaLwFullBoxCount))
            {
                var waLwFullBox = await LocalStorage.GetStringAsync(StorageKeys.IndustryWaLwFullBoxCount);
                if (int.TryParse(waLwFullBox, out var wfc) && wfc >= 1)
                    WaLwFullBoxCount = wfc;
            }

            WaLwOuterBoxBarcode =
                await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryWaLwOuterBoxBarcode, "");

            if (await LocalStorage.ContainsKeyAsync(StorageKeys.IndustryFa42FullBoxCount))
            {
                var fa42FullBox = await LocalStorage.GetStringAsync(StorageKeys.IndustryFa42FullBoxCount);
                if (int.TryParse(fa42FullBox, out var ffc) && ffc >= 1)
                    Fa42FullBoxCount = ffc;
            }

            Fa42OuterBoxBarcode =
                await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryFa42OuterBoxBarcode, "");

            InternalBarcodePrefix =
                await LocalStorage.GetStringOrDefaultAsync(StorageKeys.IndustryInternalBarcodePrefix, "");
            await LocalStorage.RemoveAsync(StorageKeys.IndustryInternalBarcodeRollSeq);

            var savedPrinter = await LocalStorage.GetStringAsync(StorageKeys.IndustrySelectedPrinter);
            if (!string.IsNullOrEmpty(savedPrinter) && Printers.Contains(savedPrinter))
                SelectedPrinter = savedPrinter;
        }
        catch
        {
            /* ignore */
        }
        finally
        {
            _suppressIndustryPersist = false;
        }
    }

    Task OnPlateTypeChanged(string? v) => SetPlateAndPersistAsync(() => PlateType = v);

    Task OnPlateItemNoChanged(string? v) => SetPlateAndPersistAsync(() => PlateItemNo = v);

    Task OnPlatePowerRateChanged(string? v) => SetPlateAndPersistAsync(() => PlatePowerRate = v);

    Task OnPlateRatedLoadChanged(string? v) => SetPlateAndPersistAsync(() => PlateRatedLoad = v);

    Task OnPlateDutyCycleChanged(string? v) => SetPlateAndPersistAsync(() => PlateDutyCycle = v);

    async Task SetPlateAndPersistAsync(Action assign)
    {
        assign();
        await PersistIndustryUiAsync();
    }

    async Task OnLabelKindChanged(int v)
    {
        SelectedLabelKind = v;
        await PersistIndustryUiAsync();
    }

    async Task OnFa17LabelKindChanged(int v)
    {
        SelectedFa17LabelKind = v;
