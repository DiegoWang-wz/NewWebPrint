@page "/LabelPrintForCustomerCustom"
@rendermode InteractiveServer
@inject SnackbarHelper SnackbarHelper
@inject LocalAgentPrinterBootstrap PrinterBootstrap

<MudPaper Class="pa-2 d-flex flex-column flex-grow-1">
    <MudPaper Class="pa-3 mb-2" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600;">客户定制标签 · 物料查询</MudText>
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="MaterialNo"
                              Label="物料号"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              OnKeyUp="OnMaterialKeyUp"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                              Placeholder="请输入物料号后查询"/>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="flex-grow-1"
                           Style="height:48px; font-size:1.05rem; font-weight:600;"
                           OnClick="SearchByMaterialAsync"
                           Disabled="@IsSearching">
                    @(IsSearching ? "查询中..." : "查询")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="my-1 d-flex flex-column pa-2 flex-grow-1" Style="min-height:160px" Elevation="2">
        @if (IsSearching)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-1"/>
        }
        <div class="table-scroll-x flex-grow-1">
            <MudTable Items="@ResultList"
                      T="EWMLabelModel"
                      Hover="true"
                      Dense="true"
                      FixedHeader="true"
                      Height="180px"
                      Breakpoint="Breakpoint.Sm"
                      RowClassFunc="@SelectedRowClass"
                      OnRowClick="OnRowClicked">
                <HeaderContent>
                    <MudTh>物料编码</MudTh>
                    <MudTh>物料组</MudTh>
                    <MudTh>物料名称</MudTh>
                    <MudTh>规格型号</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="物料编码">@context.materialCode</MudTd>
                    <MudTd DataLabel="物料组">@context.materialGroup</MudTd>
                    <MudTd DataLabel="物料名称">@context.materialName</MudTd>
                    <MudTd DataLabel="规格型号">@context.materialModel_zh</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4" Typo="Typo.subtitle2" Align="Align.Center" Color="Color.Error">
                        暂无数据
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudPaper>

    <MudPaper Class="pa-3 my-1" Elevation="2">
        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">打印（赵鉴标签 25×15）</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="string"
                           Label="打印机"
                           @bind-Value="SelectedPrinter"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Print"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           FullWidth="true">
                    @foreach (var p in Printers)
                    {
                        <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="生产日期"
                               Editable="true"
                               @bind-Date="ProductionDate"
                               DateFormat="yyyy-MM-dd"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="SerialStart"
                                 Label="流水号起始"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="PrintCount"
                                 Label="打印数量"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 Max="500"/>
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Style="height:40px; font-weight:600;"
                           OnClick="PrintSubmitAsync"
                           Disabled="@(IsPrinting || SelectedModel == null)">
                    @(IsPrinting ? "打印中" : "打印")
                </MudButton>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-2" Outlined="true" Style="background:#fafafa;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">标签预览（首张）</MudText>
                    <MudText Typo="Typo.body2" Class="font-monospace">@PreviewTypeLine</MudText>
                    <MudText Typo="Typo.body2" Class="font-monospace">@PreviewOcLine</MudText>
                    <MudText Typo="Typo.body2" Class="font-monospace">@PreviewSerialLine</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="my-1" Elevation="2">
        <OperationLog Content="@LogMessages" Title="操作日志" HeightPx="180"/>
    </MudPaper>
</MudPaper>

<style>
    .table-scroll-x {
        width: 100%;
        overflow-x: auto;
    }

    .selected-row {
        background-color: rgba(25, 118, 210, 0.12) !important;
    }

    .font-monospace {
        font-family: Consolas, "Courier New", monospace;
    }
</style>
