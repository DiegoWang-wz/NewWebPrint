<MudTabs Elevation="2" Rounded="true" Class="px-4 py-2 ma-2 tab-background" @bind-ActivePanelIndex="activeIndex"
         ApplyEffectsToContainer="true" PanelClass="pa-6 ">
    <MudTabPanel Text="遮阳100*80">
        <MudGrid Class="pa-2" GutterSize="2">
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Label="选择打印机"
