    async Task ApplyOrderPrintRangeAsync(bool resetReprintMode = true, bool logToOutput = false)
    {
        if (resetReprintMode)
            IsReprintMode = false;
        var productionNo = _data?.GetString("orderNo")?.Trim() ?? ProductionOrder.Trim();

        int nextSeq = 1;
        if (_hskBll is not null && !string.IsNullOrWhiteSpace(productionNo))
        {
            try
            {
                nextSeq = await Task.Run(() => _hskBll.GetPrintHistoryEndNum(productionNo));
                if (logToOutput)
                    AppendLog($"查询成功：订单 {productionNo}，打印起始序号 {nextSeq}");
            }
            catch (Exception ex)
            {
                if (logToOutput)
                    AppendLog($"查询订单成功，但读取打印序号失败，使用默认值 1：{ex.Message}");
                nextSeq = 1;
            }
        }

        _printSeqStartSpare = nextSeq;
        PrintSeqStart = nextSeq.ToString(CultureInfo.InvariantCulture);

        var qtyRaw = _data?.GetString("orderQuantity");
        if (double.TryParse(qtyRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var qty)
            || double.TryParse(qtyRaw, NumberStyles.Any, CultureInfo.CurrentCulture, out qty))
        {
            _orderQtyEndSpare = (int)Math.Max(1, Math.Floor(qty));
        }
        else
        {
            _orderQtyEndSpare = 0;
        }

        if (IsReprintMode)
            PrintSeqEnd = "";
        else
            ResetPrintSeqEndToOrderQty();
    }

    void SetActiveTabIndex(int index)
    {
        if (_activeTabIndex == index)
            return;

        var previous = _activeTabIndex;
        _activeTabIndex = index;

        if (previous == ReprintTabIndex && index != ReprintTabIndex)
            ExitReprintMode();
        else if (index == ReprintTabIndex && previous != ReprintTabIndex)
            EnterReprintMode();
    }

