    void ExitReprintMode()
    {
        IsReprintMode = false;
        if (_data is not null)
            _ = ApplyOrderPrintRangeAsync(logToOutput: false);
        else
        {
            PrintSeqStart = "1";
            PrintSeqEnd = "";
        }
    }

