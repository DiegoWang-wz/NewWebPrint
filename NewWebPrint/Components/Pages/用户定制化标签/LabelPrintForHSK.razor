    /// <summary>
    /// HSK 20 位编码：年份(1)+日期MMDD(4)+销单号+打印序号4位+产线(1)+订单末两位（重码时末位变 a）。
    /// 与 WinForms AddCode 拼接规则一致。
    /// </summary>
    string BuildHskBarcode20(SapEwmDynamicPayload data, DateTime date, int printSeq, bool isReprint = false)
    {
        string year1 = (date.Year - 2020).ToString(CultureInfo.InvariantCulture);
        string date4 = date.ToString("MMdd", CultureInfo.InvariantCulture);
        string salesOrder = ResolveSalesOrderForBarcode(data);
        string product2 = ResolveProduct2Suffix(data, date, isReprint);

        int seq = Math.Clamp(printSeq, 1, 9999);
        string series = seq.ToString("0000", CultureInfo.InvariantCulture);
        string lineCode = MapProductionLineToCode(SelectedProductionLine);

        return year1 + date4 + salesOrder + series + lineCode + product2;
    }

    /// <summary>销单号用于条码：保留前导零；空则用生产订单 Substring(1,8)（与 WinForms AddCode 一致）。</summary>
    static string ResolveSalesOrderForBarcode(SapEwmDynamicPayload data)
    {
        var sales = data.GetString("SalesOrderNo") ?? "";
        if (sales is "" or "0")
        {
            var po = data.GetString("orderNo") ?? "";
            return po.Length > 8 ? po.Substring(1, 8) : po;
        }

        return sales;
    }

    /// <summary>产线字母 A～Z 直接作为条码产线码；兼容旧版数字 1～16 → A～P。</summary>
    static string MapProductionLineToCode(string? lineText) => lineText switch
    {
        "1" => "A",
        "2" => "B",
        "3" => "C",
        "4" => "D",
        "5" => "E",
        "6" => "F",
        "7" => "G",
        "8" => "H",
        "9" => "I",
        "10" => "J",
        "11" => "K",
        "12" => "L",
        "13" => "M",
        "14" => "N",
        "15" => "O",
        "16" => "P",
        _ => string.IsNullOrWhiteSpace(lineText) ? "A" : lineText.Trim().ToUpperInvariant()
    };

    string ResolveProduct2Suffix(SapEwmDynamicPayload data, DateTime date, bool isReprint)
    {
        var po = data.GetString("orderNo") ?? "";
        var productNo7 = po.Length >= 8 ? po.Substring(7, 1) : "0";
        var productNo8 = po.Length >= 9 ? po.Substring(8, 1) : po.Length >= 1 ? po[^1].ToString() : "0";
        var product2 = productNo7 + productNo8;

        if (isReprint || _hskBll is null)
            return product2;

        var sales = ResolveSalesOrderForBarcode(data);
        var lineCode = MapProductionLineToCode(SelectedProductionLine);
        var year1 = (date.Year - 2020).ToString(CultureInfo.InvariantCulture);
        var date4 = date.ToString("MMdd", CultureInfo.InvariantCulture);

        try
        {
            var historyQty = _hskBll.GetHistoryQty(sales, lineCode, year1 + date4, product2);
            if (historyQty > 0)
                product2 = productNo7 + "a";
        }
        catch
        {
            // 查重失败时仍用订单末两位，不阻断打印
        }

        return product2;
    }

    void ResetPrintSeqEndToOrderQty()
    {
        if (_orderQtyEndSpare > 0)
            PrintSeqEnd = _orderQtyEndSpare.ToString(CultureInfo.InvariantCulture);
    }

    /// <summary>序号范围：1～订单量，结束≥起始；正常打印起始固定为查单时数据库序号。</summary>
    bool TryValidatePrintSeqRange(int seqStart, int seqEnd, bool isNormalPrintTab, out string errorMessage)
    {
        errorMessage = string.Empty;
        if (seqStart < 1)
        {
            errorMessage = "打印起始值无效";
            return false;
        }

        if (seqEnd < seqStart)
        {
            errorMessage = "结束值必须大于或等于起始值";
            return false;
        }

        var orderQty = ResolveOrderQuantityMax();
        if (orderQty > 0)
        {
            if (seqEnd > orderQty)
            {
                errorMessage = "结束值不可大于订单数量";
                return false;
            }

            if (seqStart > orderQty)
            {
                errorMessage = "起始值不可大于订单数量";
                return false;
            }
        }

        if (isNormalPrintTab && seqStart != _printSeqStartSpare)
        {
            errorMessage = $"起始序号应为 {_printSeqStartSpare}（由系统根据已打印记录自动给出，不可修改）";
            return false;
        }

        return true;
    }

    /// <summary>LocalAgent 多列打印：固定前缀 + {index:4} + 固定后缀（仅序号滚动）。</summary>
    string BuildHskBarcodePattern(SapEwmDynamicPayload data, DateTime date, bool isReprint)
    {
        var year1 = (date.Year - 2020).ToString(CultureInfo.InvariantCulture);
        var date4 = date.ToString("MMdd", CultureInfo.InvariantCulture);
        var salesOrder = ResolveSalesOrderForBarcode(data);
        var product2 = ResolveProduct2Suffix(data, date, isReprint);
        var lineCode = MapProductionLineToCode(SelectedProductionLine);
        return year1 + date4 + salesOrder + "{index:4}" + lineCode + product2;
    }

    List<string> BuildHskBarcodeList(SapEwmDynamicPayload data, DateTime date, int seqStart, int seqEnd, bool isReprint)
    {
        var list = new List<string>(Math.Max(0, seqEnd - seqStart + 1));
        for (var i = seqStart; i <= seqEnd; i++)
            list.Add(BuildHskBarcode20(data, date, i, isReprint));
        return list;
    }

    /// <summary>单标签模板 + GapMm 多列（LocalAgent ExpandMultiColumn）。Blocks[0] 必须为条码且 Width 参与列宽计算。</summary>
    PrintLayoutModel CreateHskMultiColumnLayout(
        string barcodePattern,
        int seqStart,
        int printCount,
        bool forcePaper37x10 = false)
    {
        var copies = Math.Max(1, CopiesPerRecord);
        var useLarge = !forcePaper37x10 && HskPaperSpec == "44*16";

        if (useLarge)
        {
            return new PrintLayoutModel
            {
                PrinterName = SelectedPrinter,
                PaperWidthMm = 91f,
                PaperHeightMm = 16f,
                Copies = copies,
                StartValue = seqStart,
                PrintCount = printCount,
                GapMm = 10f,
                Blocks = CreateHskSingleLabelBlocks91(barcodePattern)
            };
        }

        return new PrintLayoutModel
        {
            PrinterName = SelectedPrinter,
            PaperWidthMm = 77f,
            PaperHeightMm = 10f,
            Copies = copies,
            StartValue = seqStart,
            PrintCount = printCount,
            GapMm = 5.5f,
            Blocks = CreateHskSingleLabelBlocks82(barcodePattern)
        };
    }

