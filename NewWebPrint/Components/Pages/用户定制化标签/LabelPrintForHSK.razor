    async Task PrintSubmit()
    {
        if (IsPrinting) return;
        if (string.IsNullOrWhiteSpace(SelectedFactory))
        {
            SnackbarHelper.Show("请先选择工厂", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedPrinter))
        {
            SnackbarHelper.Show("请先选择打印机", Severity.Warning);
            return;
        }

        await BeginPrintingUiAsync();
        try
        {
            var date = PrintDate ?? DateTime.Today;
            var manualReprint = !string.IsNullOrWhiteSpace(ReprintBarcode);
            var isReprint = IsReprintMode || manualReprint;

            if (isReprint && !await ValidateReprintCredentialsAsync())
                return;

            if (manualReprint)
            {
                var bdCode = ReprintBarcode.Trim();
                if (bdCode.Length != 20)
                {
                    SnackbarHelper.Show("补打条码必须为 20 位", Severity.Warning);
                    return;
                }

                await PrintHskLabelsAsync(
                    date,
                    [bdCode],
                    seqStart: 0,
                    seqEnd: 0,
                    isReprint: true,
                    useMultiColumn: false,
                    persistBarcodes: true,
                    saveSeqHistory: false,
                    lockStartAfterNormalPrint: false,
                    isManualReprint: true);
                return;
            }

            if (_data is null)
            {
                SnackbarHelper.Show("请先查询生产订单后再打印", Severity.Warning);
                return;
            }

            if (!int.TryParse(PrintSeqStart, NumberStyles.Integer, CultureInfo.InvariantCulture, out var seqStart)
                || seqStart < 1)
            {
                SnackbarHelper.Show("打印起始值无效", Severity.Warning);
                return;
            }

            if (!int.TryParse(PrintSeqEnd, NumberStyles.Integer, CultureInfo.InvariantCulture, out var seqEnd))
                seqEnd = seqStart;

            var isNormalPrintTab = !IsReprintMode && string.IsNullOrWhiteSpace(ReprintBarcode);
            if (!TryValidatePrintSeqRange(seqStart, seqEnd, isNormalPrintTab, out var rangeError))
            {
                SnackbarHelper.Show(rangeError, Severity.Warning);
                return;
            }

            var barcodes = BuildHskBarcodeList(_data, date, seqStart, seqEnd, isReprint);
            foreach (var code in barcodes)
            {
                if (code.Length != 20)
                {
                    SnackbarHelper.Show($"条码长度异常（{code.Length}）", Severity.Error);
                    return;
                }
            }

            await PrintHskLabelsAsync(
                date,
                barcodes,
                seqStart,
                seqEnd,
                isReprint,
                useMultiColumn: true,
                persistBarcodes: true,
                saveSeqHistory: true,
                lockStartAfterNormalPrint: !isReprint,
                isManualReprint: false,
                isSequenceReprint: isReprint && IsReprintMode);
        }
        finally
        {
            await EndPrintingUiAsync();
        }
    }

    HskBarcodeSaveContext BuildBarcodeSaveContext(string code, bool isManualReprint, bool isSequenceReprint)
    {
        if (isManualReprint)
        {
            return new HskBarcodeSaveContext
            {
                CodeValue = code,
                IsManualReprint = true,
                ReprintUserId = ReprintAccount.Trim(),
                ReprintReason = ReprintReason,
                ResponsiblePerson = ResponsiblePerson
            };
        }

        return new HskBarcodeSaveContext
        {
            CodeValue = code,
            ProductionOrderNo = _data?.GetString("orderNo") ?? "",
            SalesOrderNo = _data is null ? "" : ResolveSalesOrderForBarcode(_data),
            ProductCode = _data?.GetString("materialCode") ?? "",
            ProductName = _data?.GetString("materialName") ?? "",
            ProductModel = _data?.GetString("materialModel_zh") ?? "",
            ProductionOrderSum = _data?.GetString("orderQuantity") ?? "",
            ScLineText = SelectedProductionLine,
            ScLineCode = MapProductionLineToCode(SelectedProductionLine),
            IsSequenceReprint = isSequenceReprint,
            ReprintUserId = ReprintAccount.Trim(),
            ReprintReason = ReprintReason,
            ResponsiblePerson = ResponsiblePerson
        };
    }

    async Task PersistBarcodesBeforePrintAsync(
        IReadOnlyList<string> barcodes,
        bool isManualReprint,
        bool isSequenceReprint)
    {
        if (_hskBll is null)
            throw new InvalidOperationException("未配置 HskCode 数据库连接");

        var factory4000 = BLLHSKCode.IsFactory4000(SelectedFactory);
        var totalSteps = barcodes.Count + 2;

        for (var i = 0; i < barcodes.Count; i++)
        {
            var code = barcodes[i];
            var ctx = BuildBarcodeSaveContext(code, isManualReprint, isSequenceReprint);
            await Task.Run(() => _hskBll.SaveBarcodeRecord(ctx, factory4000));

            if (ShouldRefreshPrintProgress(i, barcodes.Count))
            {
                await SetPrintProgressAsync(
                    i + 1,
                    totalSteps,
                    $"正在写入标签记录 {i + 1} / {barcodes.Count}");
            }
        }

        await SetPrintProgressAsync(barcodes.Count + 1, totalSteps, "正在清空 main 打印队列…");
        await Task.Run(() => _hskBll.ClearMainTable());

        AppendLog($"已生成打印记录 {barcodes.Count} 条并清除 main 旧任务");
    }

    int ResolveOrderQuantityMax()
    {
        var qtyRaw = _data?.GetString("orderQuantity");
        if (double.TryParse(qtyRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var qty)
            || double.TryParse(qtyRaw, NumberStyles.Any, CultureInfo.CurrentCulture, out qty))
        {
            return (int)Math.Max(0, Math.Floor(qty));
        }

        return 0;
    }

    async Task PrintHskLabelsAsync(
        DateTime date,
        IReadOnlyList<string> barcodes,
        int seqStart,
        int seqEnd,
        bool isReprint,
        bool useMultiColumn,
        bool persistBarcodes,
        bool saveSeqHistory,
        bool lockStartAfterNormalPrint,
        bool isManualReprint = false,
        bool isSequenceReprint = false,
        bool forcePaper37x10 = false)
    {
        try
        {
            var totalSteps = persistBarcodes ? barcodes.Count + 2 : Math.Max(barcodes.Count, 1) + 1;

            if (persistBarcodes)
                await PersistBarcodesBeforePrintAsync(barcodes, isManualReprint, isSequenceReprint);
            else if (_hskBll is not null)
            {
                await SetPrintProgressAsync(0, 1, "正在清空 main 打印队列…");
                await Task.Run(() => _hskBll.ClearMainTable());
                AppendLog("已清除 main 旧打印任务");
            }

            var paperLabel = forcePaper37x10 ? "37*10" : HskPaperSpec;

            if (useMultiColumn && _data is not null && barcodes.Count > 0)
            {
                var pattern = BuildHskBarcodePattern(_data, date, isReprint);
                var layout = CreateHskMultiColumnLayout(pattern, seqStart, barcodes.Count, forcePaper37x10);
                await SetPrintProgressAsync(
                    totalSteps - 1,
                    totalSteps,
                    $"正在提交打印任务（共 {barcodes.Count} 条条码，LocalAgent 生成中）…");
                AppendLog(
                    $"发送打印（一次任务）：{SelectedPrinter}，{paperLabel}，GapMm={layout.GapMm}，序号 {seqStart}～{seqEnd}，共 {barcodes.Count} 条条码");
                await PrinterHelper.PrintLayoutAsync(JS, layout);
            }
            else
            {
                for (var i = 0; i < barcodes.Count; i++)
                {
                    var code = barcodes[i];
                    if (ShouldRefreshPrintProgress(i, barcodes.Count))
                    {
                        await SetPrintProgressAsync(
                            i + 1,
                            barcodes.Count,
                            $"正在提交第 {i + 1} / {barcodes.Count} 个标签…");
                    }

                    var layout = CreateHskFixedCodeLayout(code, forcePaper37x10);
                    AppendLog($"发送打印：{SelectedPrinter}，{paperLabel} → {code}");
                    await PrinterHelper.PrintLayoutAsync(JS, layout);
                }
            }

            await SetPrintProgressAsync(totalSteps, totalSteps, "正在保存打印机设置…");
            await PrinterHelper.SaveLastUsedPrinterAsync(JS, SelectedPrinter, "TrayLabel_printer");

            if (saveSeqHistory && seqEnd > 0)
                await TrySavePrintSeqHistoryAsync(seqEnd);

            if (lockStartAfterNormalPrint)
                ResetPrintSeqEndToOrderQty();

            await SetPrintProgressAsync(totalSteps, totalSteps, "打印任务已提交");

            var sheetHint = useMultiColumn
                ? $"一次打印任务，{barcodes.Count} 条条码（多列排版）"
                : $"{barcodes.Count} 次打印";
            AppendLog($"打印提交成功，{sheetHint}。");
            SnackbarHelper.Show("打印提交成功", Severity.Success);
        }
        catch (Exception ex)
        {
            AppendLog($"异常：{ex.Message}");
            SnackbarHelper.Show($"异常：{ex.Message}", Severity.Error);
        }
    }

    async Task TrySavePrintSeqHistoryAsync(int printedSeq)
    {
        var productionNo = _data?.GetString("orderNo")?.Trim();
        if (_hskBll is null || string.IsNullOrWhiteSpace(productionNo))
            return;

        try
        {
            if (printedSeq > _printSeqStartSpare)
            {
                var rows = await Task.Run(() => _hskBll.AddPrintHistoryEnd(productionNo, printedSeq));
                if (rows <= 0)
                {
                    AppendLog("警告：打印序号写入数据库失败，请检查 HskCode 连接。");
                    return;
                }

                PrintSeqStart = (printedSeq + 1).ToString(CultureInfo.InvariantCulture);
                AppendLog($"已保存打印序号 {printedSeq} 至 hskcode_print_history_count，下次起始：{PrintSeqStart}");
            }
            else
            {
                PrintSeqStart = _printSeqStartSpare.ToString(CultureInfo.InvariantCulture);
                AppendLog($"序号 {printedSeq} 未超过查单时起始值 {_printSeqStartSpare}，未更新历史表（补打规则）。");
            }
        }
        catch (Exception ex)
        {
            AppendLog($"保存打印序号失败：{ex.Message}");
            SnackbarHelper.Show($"打印成功，但序号未写入数据库：{ex.Message}", Severity.Warning);
        }
    }

}