@page "/LabelPrintForHSK"
@inject SnackbarHelper SnackbarHelper
@inject LocalStorageHelper LocalStorage
@inject LocalAgentPrinterBootstrap PrinterBootstrap
@using System.Globalization
@using System.Linq
@using NewWebPrint.Models.Api
@using NewWebPrint.Services.SapEwm
@using NewWebPrint.Utilities
@inject ISapEwmService SapEwmService

@rendermode InteractiveServer

<MudGrid Class="pa-2" Justify="Justify.Center">
    <MudItem xs="12" lg="11">
        <MudPaper Elevation="3" Class="pa-2">
            <MudTabs @bind-ActivePanelIndex="ActiveTabIndex"
                     Elevation="0"
                     Rounded
                     ApplyEffectsToContainer
                     PanelClass="pa-2 pt-4">

                @* —— Tab 1：正常打印 —— *@
                <MudTabPanel Text="正常打印" Icon="@Icons.Material.Filled.Print">
                    <MudStack Spacing="1">
                        <MudGrid Spacing="2" Class="d-flex align-center">
                            <MudItem xs="12" md="8" lg="6">
                                <KeypadTarget Label="请输入生产订单号" Dense @bind-Value="ProductionOrder"/>
                            </MudItem>
                            <MudItem xs="12" md="4" lg="3" Class="d-flex align-end">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           FullWidth
                                           OnClick="@SearchSubmit"
                                           Disabled="@IsSearching">
                                    @(IsSearching ? "查询中…" : "查询")
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (IsSearching)
                        {
                            <MudProgressLinear Indeterminate Color="Color.Info"/>
                        }

                        <MudTable Items="@(_data is null ? Enumerable.Empty<int>() : new List<int> { 1 })"
                                  T="int"
                                  Hover
                                  Dense
                                  Breakpoint="Breakpoint.Sm"
                                  Outlined>
                            <HeaderContent>
                                <MudTh>@T["HskOrderDetail_ColOrderNo"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColSalesOrder"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColMaterialCode"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColMaterialName"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColSpec"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColOrderQty"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@T["HskOrderDetail_ColOrderNo"]">@_data!.GetString("orderNo")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColSalesOrder"]">@_data.GetString("SalesOrderNo")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColMaterialCode"]">@_data.GetString("materialCode")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColMaterialName"]">@_data.GetString("materialName")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColSpec"]">@_data.GetString("materialModel_zh")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColOrderQty"]">@_data.GetString("orderQuantity")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Align="Align.Center"
                                         Class="pa-2">@T["HskOrderDetail_NoData"]</MudText>
                            </NoRecordsContent>
                        </MudTable>

                        <MudGrid Spacing="2" Class="mt-2">
                            <MudItem xs="12" md="8">
                                <MudPaper Outlined Class="pa-2">
                                    <MudStack Spacing="3">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="请选择生产的产线"
                                                           @bind-Value="SelectedProductionLine"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense
                                                           FullWidth>
                                                    @foreach (var line in ProductionLineOptions)
                                                    {
                                                        <MudSelectItem T="string" Value="@line">@line</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="工厂" @bind-Value="SelectedFactory"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense
                                                           Placeholder="请选择" FullWidth>
                                                    @foreach (var factory in FactoryOptions)
                                                    {
                                                        <MudSelectItem T="string"
                                                                       Value="@factory">@factory</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                        </MudGrid>

                                        <MudStack Row="true" Class="px-5">
                                            <MudStack Row="true" Class="d-flex align-center">
                                                <MudText Typo="Typo.body2">请输入打印起始值：</MudText>
                                                <KeypadTarget Label="" @bind-Value="PrintSeqStart" Dense Disabled/>
                                                <MudText Typo="Typo.h6">~</MudText>
                                                <KeypadTarget Label="" @bind-Value="PrintSeqEnd" Dense/>
                                            </MudStack>
                                            <MudSpacer/>
                                            <MudRadioGroup Value="HskPaperSpec" ValueChanged="OnHskPaperSpecChanged" T="string">
                                                <MudStack Spacing="1" Row="true" Justify="Justify.FlexEnd">
                                                    <MudRadio Value="@("37*10")" Color="Color.Primary" Dense>37*10
                                                    </MudRadio>
                                                    <MudRadio Value="@("44*16")" Color="Color.Primary" Dense>44*16
                                                    </MudRadio>
                                                </MudStack>
                                            </MudRadioGroup>
                                        </MudStack>

                                        <KeypadTarget TValue="int" Label="每条记录打印份数"
                                                      @bind-Value="CopiesPerRecord" Dense/>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudPaper Outlined Class="pa-2">
                                    <MudStack Spacing="3" Class="h-100">
                                        <MudDatePicker Label="@T["DateLabel"]" Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       @bind-Date="PrintDate" FullWidth/>
                                        <MudSelect T="string" Label="@T["SelectPrinter"]" @bind-Value="SelectedPrinter"
                                                   Margin="Margin.Dense" Dense FullWidth
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Print"
                                                   Variant="Variant.Outlined">
                                            @foreach (var p in Printers)
                                            {
                                                <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                            }
                                        </MudSelect>

                                        <MudTooltip Text="@NormalPrintDisableHint">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Success"
                                                       Size="Size.Large"
                                                       FullWidth
                                                       StartIcon="@Icons.Material.Filled.Print"
                                                       OnClick="@PrintSubmit"
                                                       Disabled="@(IsPrinting || !CanNormalPrint)">
                                                @(IsPrinting ? T["Printing"] : T["Print"])
                                            </MudButton>
                                        </MudTooltip>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>

                @* —— Tab 2：补打 —— *@
                <MudTabPanel Text="补打" Icon="@Icons.Material.Filled.Replay">
                    <MudStack Spacing="1">
                        <MudGrid Spacing="2" Class="d-flex align-center">
                            <MudItem xs="12" md="8" lg="6">
                                <KeypadTarget Label="请输入生产订单号" Dense @bind-Value="ProductionOrder"/>
                            </MudItem>
                            <MudItem xs="12" md="4" lg="3" Class="d-flex align-end">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           FullWidth
                                           OnClick="@SearchSubmit"
                                           Disabled="@IsSearching">
                                    @(IsSearching ? "查询中…" : "查询")
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (IsSearching)
                        {
                            <MudProgressLinear Indeterminate Color="Color.Info"/>
                        }

                        <MudTable Items="@(_data is null ? Enumerable.Empty<int>() : new List<int> { 1 })"
                                  T="int"
                                  Hover
                                  Dense
                                  Breakpoint="Breakpoint.Sm"
                                  Outlined>
                            <HeaderContent>
                                <MudTh>@T["HskOrderDetail_ColOrderNo"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColSalesOrder"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColMaterialCode"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColMaterialName"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColSpec"]</MudTh>
                                <MudTh>@T["HskOrderDetail_ColOrderQty"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@T["HskOrderDetail_ColOrderNo"]">@_data!.GetString("orderNo")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColSalesOrder"]">@_data.GetString("SalesOrderNo")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColMaterialCode"]">@_data.GetString("materialCode")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColMaterialName"]">@_data.GetString("materialName")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColSpec"]">@_data.GetString("materialModel_zh")</MudTd>
                                <MudTd
                                    DataLabel="@T["HskOrderDetail_ColOrderQty"]">@_data.GetString("orderQuantity")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Align="Align.Center"
                                         Class="pa-2">@T["HskOrderDetail_NoData"]</MudText>
                            </NoRecordsContent>
                        </MudTable>

                        <MudGrid Spacing="2" Class="mt-2">
                            <MudItem xs="12" md="8">
                                <MudPaper Outlined Class="pa-2">
                                    <MudStack Spacing="3">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="请选择生产的产线"
                                                           @bind-Value="SelectedProductionLine"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense
                                                           FullWidth>
                                                    @foreach (var line in ProductionLineOptions)
                                                    {
                                                        <MudSelectItem T="string" Value="@line">@line</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="工厂" @bind-Value="SelectedFactory"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense
                                                           Placeholder="请选择" FullWidth>
                                                    @foreach (var factory in FactoryOptions)
                                                    {
                                                        <MudSelectItem T="string"
                                                                       Value="@factory">@factory</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <KeypadTarget @bind-Value="ReprintAccount" Label="补打账号" Dense/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="ReprintPassword" Label="账号密码"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                                              InputType="InputType.Password" FullWidth/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <KeypadTarget @bind-Value="ResponsiblePerson" Label="责任人" Dense/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <KeypadTarget @bind-Value="ReprintReason" Label="补打原因" Dense/>
                                            </MudItem>
                                        </MudGrid>


                                        <MudStack Row="true" Class="px-5">
                                            <MudStack Row="true" Class="d-flex align-center">
                                                <MudText Typo="Typo.body2">请输入打印起始值：</MudText>
                                                <KeypadTarget Label="" @bind-Value="PrintSeqStart" Dense/>
                                                <MudText Typo="Typo.h6">~</MudText>
                                                <KeypadTarget Label="" @bind-Value="PrintSeqEnd" Dense/>
                                            </MudStack>
                                            <MudSpacer/>
                                            <MudRadioGroup Value="HskPaperSpec" ValueChanged="OnHskPaperSpecChanged" T="string">
                                                <MudStack Spacing="1" Row="true" Justify="Justify.FlexEnd">
                                                    <MudRadio Value="@("37*10")" Color="Color.Primary" Dense>37*10
                                                    </MudRadio>
                                                    <MudRadio Value="@("44*16")" Color="Color.Primary" Dense>44*16
                                                    </MudRadio>
                                                </MudStack>
                                            </MudRadioGroup>
                                        </MudStack>


                                        <MudStack Row Spacing="2" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled>补打台账
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled>修改密码
                                            </MudButton>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudPaper Outlined Class="pa-2">
                                    <MudStack Spacing="3" Class="h-100">
                                        <MudStack Row="true">
                                            <MudDatePicker Label="@T["DateLabel"]" Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           @bind-Date="PrintDate" FullWidth/>
                                            <KeypadTarget TValue="int" Label="每条记录打印份数"
                                                          @bind-Value="CopiesPerRecord" Dense/>
                                        </MudStack>

                                        <MudSelect T="string" Label="@T["SelectPrinter"]" @bind-Value="SelectedPrinter"
                                                   Margin="Margin.Dense" Dense FullWidth
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Print"
                                                   Variant="Variant.Outlined">
                                            @foreach (var p in Printers)
                                            {
                                                <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <KeypadTarget @bind-Value="ReprintBarcode" Label="请输入补打条码" Dense/>
                                        <MudTooltip Text="@ReprintPrintDisableHint">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Warning"
                                                       Size="Size.Large"
                                                       FullWidth
                                                       StartIcon="@Icons.Material.Filled.Replay"
                                                       OnClick="@PrintSubmit"
                                                       Disabled="@(IsPrinting || !CanReprint)">
                                                @(IsPrinting ? T["Printing"] : "补打打印")
                                            </MudButton>
                                        </MudTooltip>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>

                @* —— Tab 3：NG 条码打印 —— *@
                <MudTabPanel Text="NG条码打印" Icon="@Icons.Material.Filled.Warning">
                    <MudStack Spacing="3">
                        <MudGrid Spacing="2" Class="d-flex align-center">
                            <MudItem xs="12" md="4" lg="6">
                                <KeypadTarget Label="请输入 NG 条码生产订单" Dense @bind-Value="NgProductionOrder"/>
                            </MudItem>
    
                            <MudItem xs="12" md="4" lg="3">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           FullWidth
                                           OnClick="@SearchNgSubmit"
                                           Disabled="@IsSearchingNg">
                                    @(IsSearchingNg ? "查询中…" : "查询")
                                </MudButton>
                            </MudItem>

                            <MudItem xs="12" md="4" lg="3" Class="d-flex justify-end gap-2">
                                <MudButton Variant="Variant.Outlined" OnClick="@SelectAllNg"
                                           Disabled="@(NgBarcodeRows.Count == 0)">
                                    全选
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="@ClearNgSelection"
                                           Disabled="@(NgBarcodeRows.Count == 0)">
                                    取消
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (IsSearchingNg)
                        {
                            <MudProgressLinear Indeterminate Color="Color.Info"/>
                        }
                        

                        <MudTable Items="@NgBarcodeRows"
                                  T="NgBarcodeRow"
                                  Hover
                                  Dense
                                  Breakpoint="Breakpoint.Sm"
                                  Outlined
                                  MultiSelection
                                  @bind-SelectedItems="NgSelectedRows">
                            <HeaderContent>
                                <MudTh>NG条码</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="NG条码">@context.Barcode</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-2">
                                    请输入生产订单并查询 NG 条码
                                </MudText>
                            </NoRecordsContent>
                        </MudTable>
                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <OperationLog Content="@PrintMessages" Title="在此输出信息"/>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudPaper Outlined Class="pa-2">
                                    <MudStack Spacing="3" Class="h-100">
                                        <MudDatePicker Label="@T["DateLabel"]" Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       @bind-Date="PrintDate" FullWidth/>
                                        <MudSelect T="string" Label="@T["SelectPrinter"]" @bind-Value="SelectedPrinter"
                                                   Margin="Margin.Dense" Dense FullWidth
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Print"
                                                   Variant="Variant.Outlined">
                                            @foreach (var p in Printers)
                                            {
                                                <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudTooltip Text="@NgPrintDisableHint">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Error"
                                                       Size="Size.Large"
                                                       FullWidth
                                                       StartIcon="@Icons.Material.Filled.Print"
                                                       OnClick="@PrintNgSelectedSubmit"
                                                       Disabled="@(IsPrinting || !CanNgPrint)">
                                                @(IsPrinting ? T["Printing"] : "打印选中条码")
                                            </MudButton>
                                        </MudTooltip>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>
            </MudTabs>

            @if (IsPrinting)
            {
                <MudPaper Outlined Class="pa-3 mt-2 mb-2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2">@PrintProgressLabel</MudText>
                        @if (PrintProgressTotal > 0)
                        {
                            <MudProgressLinear Value="@PrintProgressValue"
                                               Color="Color.Primary"
                                               Rounded
                                               Size="Size.Medium"/>
                            <MudText Typo="Typo.caption" Align="Align.End">
                                @PrintProgressCurrent / @PrintProgressTotal（@PrintProgressPercentText）
                            </MudText>
                        }
                        else
                        {
                            <MudProgressLinear Indeterminate Color="Color.Primary" Rounded Size="Size.Medium"/>
                        }
                    </MudStack>
                </MudPaper>
            }

            @if (ActiveTabIndex == 1 || ActiveTabIndex == 0)
            {
                <OperationLog Content="@PrintMessages" Title="在此输出信息" HeightPx="180"/>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    List<string> Printers { get; set; } = new();
    string? DefaultPrinter { get; set; }
    string? SelectedPrinter { get; set; }
    bool IsPrinting { get; set; }
    int PrintProgressCurrent { get; set; }
    int PrintProgressTotal { get; set; }
    string PrintProgressLabel { get; set; } = string.Empty;
    string PrintMessages { get; set; } = string.Empty;

    double PrintProgressValue =>
        PrintProgressTotal > 0 ? (double)PrintProgressCurrent / PrintProgressTotal * 100d : 0d;

    string PrintProgressPercentText =>
        PrintProgressTotal > 0
            ? $"{PrintProgressValue:F0}%"
            : string.Empty;
    DateTime? PrintDate { get; set; } = DateTime.Today;

    /// <summary>37*10 → 纸张 77×10mm；44*16 → 纸张 91×16mm</summary>
    string HskPaperSpec { get; set; } = "37*10";

    /// <summary>产线下拉 A～Z（与 WinForms comboBox_Line 一致，条码产线码即所选字母）。</summary>
    static readonly string[] ProductionLineOptions =
        Enumerable.Range('A', 26).Select(c => ((char)c).ToString(CultureInfo.InvariantCulture)).ToArray();

    static readonly string[] FactoryOptions =
    [
        "1101全球生产基地",
        "1200海仕凯",
        "4000 J-Star MYS"
    ];

    string SelectedProductionLine { get; set; } = "A";
    int _orderQtyEndSpare;
    string? SelectedFactory { get; set; }
    string PrintSeqStart { get; set; } = "1";
    string PrintSeqEnd { get; set; } = "";
    bool IsReprintMode { get; set; }
    int CopiesPerRecord { get; set; } = 1;
    string ReprintBarcode { get; set; } = "";
    string ReprintAccount { get; set; } = "";
    string ReprintPassword { get; set; } = "";
    string ResponsiblePerson { get; set; } = "";
    string ReprintReason { get; set; } = "";

    const int ReprintTabIndex = 1;
    const int NgTabIndex = 2;

    int _activeTabIndex;

    int ActiveTabIndex
    {
        get => _activeTabIndex;
        set => SetActiveTabIndex(value);
    }

    bool HasValidReprintBarcode =>
        !string.IsNullOrWhiteSpace(ReprintBarcode) && ReprintBarcode.Trim().Length == 20;

    bool CanNormalPrint =>
        _data is not null
        && !string.IsNullOrWhiteSpace(SelectedFactory)
        && !string.IsNullOrWhiteSpace(SelectedPrinter)
        && string.IsNullOrWhiteSpace(ReprintBarcode);

    /// <summary>补打：工厂/打印机/账号/原因 +（已查单 或 20 位补打条码）。</summary>
    bool CanReprint =>
        !string.IsNullOrWhiteSpace(SelectedFactory)
        && !string.IsNullOrWhiteSpace(SelectedPrinter)
        && !string.IsNullOrWhiteSpace(ReprintReason)
        && !string.IsNullOrWhiteSpace(ReprintAccount)
        && (_data is not null || HasValidReprintBarcode);

    string NormalPrintDisableHint => GetNormalPrintDisableHint();

    string ReprintPrintDisableHint => GetReprintPrintDisableHint();

    bool CanNgPrint =>
        !string.IsNullOrWhiteSpace(SelectedFactory)
        && !string.IsNullOrWhiteSpace(SelectedPrinter)
        && !string.IsNullOrWhiteSpace(ReprintReason)
        && !string.IsNullOrWhiteSpace(ReprintAccount)
        && NgSelectedRows.Count > 0;

    string NgPrintDisableHint => GetNgPrintDisableHint();

    private SapEwmDynamicPayload? _data;
    string ProductionOrder { get; set; } = "";
    bool IsSearching { get; set; }

    string NgProductionOrder { get; set; } = "";
    bool IsSearchingNg { get; set; }
    List<NgBarcodeRow> NgBarcodeRows { get; set; } = new();
    HashSet<NgBarcodeRow> NgSelectedRows { get; set; } = new();

    sealed record NgBarcodeRow(string Barcode);

    /// <summary>查单时的起始序号备用（WinForms start_spare），用于判断是否回写历史表。</summary>
    int _printSeqStartSpare = 1;

    BLLHSKCode? _hskBll;

    protected override async Task OnInitializedAsync()
    {
        _hskBll = new BLLHSKCode(Config);
        await LoadHskPaperSpecAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await PrinterBootstrap.TryLoadOnFirstRenderAsync(
            firstRender,
            "TrayLabel_printer",
            ApplyPrinterLoadResult,
            () => InvokeAsync(StateHasChanged));
    }

    void ApplyPrinterLoadResult(PrinterLoadResult result)
    {
        if (!result.Success) return;
        Printers = result.Printers.ToList();
        DefaultPrinter = result.DefaultPrinter;
        SelectedPrinter = result.SelectedPrinter;
    }

    async Task LoadHskPaperSpecAsync()
    {
        try
        {
            var saved = await LocalStorage.GetStringAsync(StorageKeys.LabelPrintForHskPaperSpec);
            if (saved is "37*10" or "44*16")
                HskPaperSpec = saved;
        }
        catch
        {
            // 忽略 storage 读取失败
        }
