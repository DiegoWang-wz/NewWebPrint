@using NewWebPrint.Models.Hu
@using NewWebPrint.Utilities

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">标签预览（近似）</MudText>
    </TitleContent>
    <DialogContent>
        <div class="hu-preview-wrap">
            <div class="hu-label" style="@($"width:{LabelWidthPx}px;height:{LabelHeightPx}px;")">
                <div class="hu-cell hu-label-l" style="@Cell(2, 2, 25, 6)">Supplier</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 2, 46, 6)">@Item.LIFNR</div>
                <div class="hu-cell" style="@Cell(73, 2, 25, 6)"></div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 8, 25, 6)">Pur.order/Item</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 8, 23, 6)">@Item.EBELN</div>
                <div class="hu-cell hu-label-v" style="@Cell(50, 8, 23, 6)">@Item.EBELP</div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 14, 25, 6)">Sal.order/Item</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 14, 23, 6)">@Item.VBELV</div>
                <div class="hu-cell hu-label-v" style="@Cell(50, 14, 23, 6)"></div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 20, 25, 6)">Mat./Batch</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 20, 23, 6)">@Item.MATNR</div>
                <div class="hu-cell hu-label-v" style="@Cell(50, 20, 23, 6)">@BatchNo</div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 26, 25, 6)">Plant/SLoc</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 26, 23, 6)">@Item.WERKS</div>
                <div class="hu-cell hu-label-v" style="@Cell(50, 26, 23, 6)">@Item.LGORT</div>

                <div class="hu-qr" style="@Cell(73, 8, 25, 24)">
                    @if (!string.IsNullOrWhiteSpace(QrImageBase64))
                    {
                        <img src="@QrImageBase64" alt="QR"/>
                    }
                </div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 32, 25, 10)">Mat.Description</div>
                <div class="hu-cell hu-label-v hu-multi" style="@Cell(27, 32, 71, 10)">@Item.MAKTX</div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 42, 25, 14)">Specification</div>
                <div class="hu-cell hu-label-v hu-multi" style="@Cell(27, 42, 71, 14)">@Item.ZCTEXT</div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 56, 25, 8)">Qty/Pallet</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 56, 20, 8)">@QtyDisplay</div>
                <div class="hu-cell hu-label-l" style="@Cell(47, 56, 26, 8)">MPQ</div>
                <div class="hu-cell hu-label-v" style="@Cell(73, 56, 25, 8)">@Item.MQP</div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 64, 25, 6)">Printing Date</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 64, 71, 6)">@DateTime.Now.ToString("yyyy-MM-dd")</div>

                <div class="hu-cell hu-label-l" style="@Cell(2, 70, 25, 6)">remark</div>
                <div class="hu-cell hu-label-v" style="@Cell(27, 70, 71, 6)">@Item.IDNLF</div>
            </div>
            <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                近似预览，比例约 100×80 mm；实际打印以 LocalAgent 为准。
            </MudText>
            <MudText Typo="Typo.caption" Class="font-monospace mt-1" Style="word-break:break-all;">
                QR: @QrValue
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close">关闭</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .hu-preview-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 4px 0;
    }

    .hu-label {
        position: relative;
        background: #fff;
        border: 1px solid #222;
        box-sizing: border-box;
        overflow: hidden;
        font-family: "Times New Roman", Times, serif;
        color: #111;
    }

    .hu-cell {
        position: absolute;
        border: 1px solid #222;
        box-sizing: border-box;
        padding: 1px 3px;
        overflow: hidden;
        display: flex;
        align-items: center;
        font-size: 11px;
        line-height: 1.15;
        background: #fff;
    }

    .hu-label-l {
        font-weight: 600;
        white-space: nowrap;
    }

    .hu-label-v {
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .hu-multi {
        white-space: normal;
        align-items: flex-start;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .hu-qr {
        position: absolute;
        border: 1px solid #222;
        box-sizing: border-box;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
    }

    .hu-qr img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>

@code {
    const float Scale = 4.2f; // 1mm → px，预览约 420×336
    const float LabelWidthPx = 100f * Scale;
    const float LabelHeightPx = 80f * Scale;

    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public HuDataItem Item { get; set; } = new();

    [Parameter]
    public string BoxQty { get; set; } = "";

    [Parameter]
    public string BatchNo { get; set; } = "";

    [Parameter]
    public string UnitText { get; set; } = "";

    string QrValue { get; set; } = "";
    string? QrImageBase64 { get; set; }

    string QtyDisplay => string.IsNullOrWhiteSpace(UnitText)
        ? BoxQty
        : $"{BoxQty} {UnitText}".Trim();

    protected override void OnInitialized()
    {
        const string huValue = "00";
        QrValue = $"{Item.EBELN}/{Item.EBELP}/{Item.MATNR}/{BoxQty}/{BoxQty}/{huValue}/{Item.VBELV}/{Item.POSNV}/BATCH/{BatchNo}";
        QrImageBase64 = QrCodeHelper.TryGenerateBase64(QrValue, "M", 220, 220);
    }

    static string Cell(float xMm, float yMm, float wMm, float hMm) =>
        $"left:{xMm * Scale:0.##}px;top:{yMm * Scale:0.##}px;width:{wMm * Scale:0.##}px;height:{hMm * Scale:0.##}px;";

    void Close() => MudDialog.Close();
}
