@inject IConfiguration Config

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">报工</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2" Class="mb-2">
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => LoadUrl(_url720))">720</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => LoadUrl(_url500))">500</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => LoadUrl(_url800))">800</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => LoadUrl(_defaultUrl))">默认</MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@_currentUrl</MudText>
        </MudStack>
        <div style="width:100%; height:70vh; border:1px solid #e0e0e0; border-radius:4px; overflow:hidden;">
            @if (!string.IsNullOrWhiteSpace(_currentUrl))
            {
                <iframe src="@_currentUrl"
                        title="报工"
                        style="width:100%; height:100%; border:0;"
                        referrerpolicy="no-referrer">
                </iframe>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    const string _url720 = "http://120.26.62.131:8000/sap/bc/gui/sap/its/zrfmenu/?sap-client=720&sap-language=ZH";
    const string _url500 = "http://120.55.41.192:8000/sap/bc/gui/sap/its/zrfmenu/?sap-client=500&sap-language=ZH";
    const string _url800 = "http://121.40.70.94:8000/sap/bc/gui/sap/its/zrfmenu/?sap-client=800&sap-language=ZH";

    string _defaultUrl = "";
    string _currentUrl = "";

    protected override void OnInitialized()
    {
        _defaultUrl = Config["reportUrl"]?.Trim()
                      ?? "http://61.175.247.114:7081/Application/workbench";
        _currentUrl = _defaultUrl;
    }

    void LoadUrl(string url) => _currentUrl = url;

    void Close() => MudDialog.Close();
}
