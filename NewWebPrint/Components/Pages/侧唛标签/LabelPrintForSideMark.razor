@code {
    List<string> Printers { get; set; } = new();
    string? DefaultPrinter { get; set; }
    string? SelectedPrinter { get; set; }
    bool IsPrinting { get; set; }
    string PrintMessages { get; set; } = string.Empty;
    string LabelType { get; set; } = "";
    DateTime? PrintDate { get; set; } = DateTime.Today;
    string StablePrintCount { get; set; } = "1";
    string BoxPCS { get; set; } = "1";
    bool IsInventoryOrder { get; set; }
    bool Rotate90 { get; set; }
    string Bi10Value { get; set; } = "";
    string ReprintSerialStart { get; set; } = "0";
    string ReprintSerialEnd { get; set; } = "0";
    string UserId { get; set; } = "";
    private string _weightActual = string.Empty;

    string WeightActual
    {
        get => _weightActual;
        set
        {
            _weightActual = value ?? string.Empty;
            RecalculateWeightTolerance();
        }
    }

    private string _weightStandard = string.Empty;

    string WeightStandard
    {
        get => _weightStandard;
        set
        {
            _weightStandard = value ?? string.Empty;
            RecalculateWeightTolerance();
        }
    }

    string WeightTolerance { get; set; } = "";
    string CustomerShortName { get; set; } = "";
    string GujiaFireWorkOrderNo { get; set; } = "";
    DateTime? ProductionDate { get; set; } = DateTime.Today;
    string SerialPrefix { get; set; } = "JC";
    bool IsGujiaSideMarkPrint { get; set; }
    bool IsAddProductionSerialPrint { get; set; }
    bool IsYinaSideMarkPrint { get; set; }

    private SapEwmDynamicPayload? _data;
    private List<SapEwmDynamicPayload> _tableRows = new();
    string ProductionOrder { get; set; } = "";
    string DeliveryOrSalesOrderNo { get; set; } = "11292604";
    bool IsSearching { get; set; }
    private bool _isSerialOpen;
    private DotNetObjectReference<LabelPrintForSideMark>? _objRef;

    protected override void OnInitialized()
    {
        _objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await PrinterBootstrap.TryLoadOnFirstRenderAsync(
            firstRender,
            "TrayLabel_printer",
            ApplyPrinterLoadResult,
            () => InvokeAsync(StateHasChanged));
    }

    void ApplyPrinterLoadResult(PrinterLoadResult result)
    {
        if (!result.Success) return;
        Printers = result.Printers.ToList();
        DefaultPrinter = result.DefaultPrinter;
        SelectedPrinter = result.SelectedPrinter;
    }

    async Task EnableWeight()
    {
        const string validUser = "100660";
        if (UserId?.Trim() != validUser)
        {
            SnackbarHelper.Show($"工号必须为 {validUser} 才能连接称重器", Severity.Warning);
            return;
        }

        try
        {
            if (_isSerialOpen)
            {
                await JS.InvokeVoidAsync("serialInterop.closePort");
                _isSerialOpen = false;
                SnackbarHelper.Show("称重器已停止", Severity.Info);
                AppendLog("WebSerial 称重连接已关闭");
                await InvokeAsync(StateHasChanged);
                return;
            }

            var baud = await JS.InvokeAsync<string>("serialInterop.getPreferredScaleBaud");
            var br = int.TryParse(baud, out var n) ? n : 19200;
            var config = new
            {
                baudRate = baud,
                parity = "none",
                dataBits = "8",
                stopBits = "1",
                autoScaleBaud = br is 9600 or 19200
            };
            var success = await JS.InvokeAsync<bool>("serialInterop.openPort", config, _objRef);
            if (!success)
            {
                SnackbarHelper.Show("称重器连接失败或已取消", Severity.Error);
                AppendLog("WebSerial 称重连接失败或已取消");
                return;
            }

            _isSerialOpen = true;
            SnackbarHelper.Show("称重器连接成功", Severity.Success);
            AppendLog("WebSerial 称重连接成功");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            SnackbarHelper.Show($"称重器连接异常: {ex.Message}", Severity.Error);
            AppendLog($"称重器连接异常: {ex.Message}");
        }
    }

    async Task SearchSubmit()
    {
        if (IsSearching) return;
        var po = ProductionOrder?.Trim();
        var so = DeliveryOrSalesOrderNo?.Trim();
        if (string.IsNullOrWhiteSpace(po) && string.IsNullOrWhiteSpace(so))
        {
            SnackbarHelper.Show("请输入生产订单号或销售/发货订单号", Severity.Warning);
            return;
        }

        IsSearching = true;
        _data = null;
        _tableRows.Clear();
        await InvokeAsync(StateHasChanged);

        try
        {
            List<SapEwmDynamicPayload> resultRows = new();
            if (!string.IsNullOrWhiteSpace(po))
            {
                // 与原 WinForm 一致：按生产单查询时固定中文参数 lang=1
                var response = await SapEwmService.InvokeDynamicAsync(
                    "GetProductInfo",
                    new Dictionary<string, string?> { ["po"] = po, ["lang"] = "1" },
                    logToBrowserConsole: true);
                if (response.Code != ApiResultCode.Success || response.Data is null)
                {
                    SnackbarHelper.Show(response.Message, Severity.Error);
                    return;
                }

                resultRows.Add(NormalizeSapPayload(response.Data));
            }
            else
            {
                // 与原 WinForm 一致：销售单先查 GetSaleInfoCM，失败再回退 GetDeliveryInfoCM
                resultRows = await QueryBySalesOrDeliveryAsync(so!);
                if (resultRows.Count == 0)
                {
                    SnackbarHelper.Show("未找到对应订单数据", Severity.Warning);
                    return;
                }
            }

            _tableRows = resultRows;
            _data = _tableRows[0];
            LabelType = _data.GetString("jclogoText", "HaveJiecangLOGO") ?? string.Empty;
            Bi10Value = _data.GetString("ZI10", "STTXT") ?? string.Empty;

            SnackbarHelper.Show("查询成功", Severity.Success);
        }
        catch (Exception ex)
        {
            SnackbarHelper.Show($"查询失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task<List<SapEwmDynamicPayload>> QueryBySalesOrDeliveryAsync(string so)
    {
        var rows = new List<SapEwmDynamicPayload>();
        var saleResponse = await SapEwmService.InvokeAsync(
            "GetSaleInfoCM",
            new Dictionary<string, string?> { ["so"] = so },
            logToBrowserConsole: true);
        rows = ExtractPayloadListFromInvoke(saleResponse.Data)
            .Select(NormalizeSapPayload)
            .ToList();
        if (rows.Count > 0)
            return rows;

        var deliveryResponse = await SapEwmService.InvokeAsync(
            "GetDeliveryInfoCM",
            new Dictionary<string, string?> { ["so"] = so },
            logToBrowserConsole: true);
        return ExtractPayloadListFromInvoke(deliveryResponse.Data)
            .Select(NormalizeSapPayload)
            .ToList();
    }

    List<SapEwmDynamicPayload> ExtractPayloadListFromInvoke(SapEwmInvokeResult? invokeResult)
    {
        var result = new List<SapEwmDynamicPayload>();
        if (invokeResult is null || !invokeResult.Success)
            return result;

        var raw = invokeResult.ResultText ?? invokeResult.JsonResult;
        if (string.IsNullOrWhiteSpace(raw))
            return result;

        try
        {
            using var doc = JsonDocument.Parse(raw);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                result.Add(SapEwmDynamicPayload.FromJson(
                    doc.RootElement.GetRawText(),
                    invokeResult.RawSoapResponse,
                    invokeResult.Endpoint,
                    invokeResult.Network,
                    invokeResult.SoapVersion));
                return result;
            }

            if (doc.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in doc.RootElement.EnumerateArray())
                {
                    if (item.ValueKind != JsonValueKind.Object)
                        continue;

                    result.Add(SapEwmDynamicPayload.FromJson(
                        item.GetRawText(),
                        invokeResult.RawSoapResponse,
                        invokeResult.Endpoint,
                        invokeResult.Network,
                        invokeResult.SoapVersion));
                }
            }
        }
        catch
        {
        }

        return result;
    }

