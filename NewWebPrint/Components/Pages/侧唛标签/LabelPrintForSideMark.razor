    /// <summary>罗马尼亚模板：条形码值 -> 模板文件路径（来自 wwwroot/templates）。</summary>
    Dictionary<string, string>? _romaniaBarcodeTemplateMap;

    async Task PrintHangRailSideMarkAsync(int copies, int startSerial)
    {
        var materialName = (_data?.GetString("materialName") ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(materialName))
        {
            SnackbarHelper.Show("物料名称为空，无法打印挂衣杆侧唛", Severity.Warning);
            return;
        }

        var salesNo = (_data?.GetString("SalesOrderNo") ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(salesNo))
            salesNo = (_data?.GetString("orderNo") ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(salesNo))
        {
            SnackbarHelper.Show("销售订单号为空，无法打印挂衣杆侧唛", Severity.Warning);
            return;
        }

        const int maxPairs = 500;
        if (copies > maxPairs)
        {
            SnackbarHelper.Show($"打印数量过大（一次最多 {maxPairs}）", Severity.Warning);
            return;
        }

        var dateText = (ProductionDate ?? PrintDate ?? DateTime.Today).ToString("yyMMdd", CultureInfo.InvariantCulture);
        var templatePath = Path.Combine(Env.WebRootPath, "templates", "挂衣杆侧唛模板.json");
        if (!File.Exists(templatePath))
        {
            SnackbarHelper.Show("未找到挂衣杆模板（wwwroot/templates/挂衣杆侧唛模板.json）", Severity.Error);
            return;
        }

        string templateJson;
        try
        {
            templateJson = await File.ReadAllTextAsync(templatePath);
        }
        catch (Exception ex)
        {
            SnackbarHelper.Show($"读取挂衣杆模板失败：{ex.Message}", Severity.Error);
            return;
        }

        IsPrinting = true;
        AppendLog($"挂衣杆打印：物料 {materialName}，销售单 {salesNo}，日期 {dateText}，起始序号 {startSerial}，打印数量 {copies} → 流水 {startSerial}..{startSerial + copies - 1}（每个流水 RIGHT+LEFT）");

        try
        {
            for (var i = 0; i < copies; i++)
            {
                var serial = startSerial + i;
                var serialLine = $"{salesNo}-{dateText}-{serial.ToString("D5", CultureInfo.InvariantCulture)}";
                foreach (var title in new[] { "TYPE:RIGHT BODY", "TYPE:LEFT BODY" })
                {
                    var layout = JsonConvert.DeserializeObject<PrintLayoutModel>(templateJson);
                    if (layout == null)
                    {
                        SnackbarHelper.Show("挂衣杆模板解析为空", Severity.Error);
                        return;
                    }

                    layout.PrinterName = SelectedPrinter;
                    layout.PaperWidthMm = 100f;
                    layout.PaperHeightMm = 80f;
                    layout.Copies = 1;
                    layout.StartValue = 1;
                    layout.PrintCount = 1;

                    SetHangRailBlockText(layout, "title", title);
                    SetHangRailBlockText(layout, "material_des", materialName);
                    SetHangRailBlockText(layout, "serialnum", serialLine);

                    await PrinterHelper.PrintLayoutAsync(JS, layout);
                    AppendLog($"已提交：{title} / {serialLine}");
                }
            }

            CustomSerialStart = (startSerial + copies).ToString(CultureInfo.InvariantCulture);
            await PrinterHelper.SaveLastUsedPrinterAsync(JS, SelectedPrinter, "TrayLabel_printer");
            AppendLog($"挂衣杆打印提交成功，下一起始序号 {CustomSerialStart}");
            SnackbarHelper.Show("打印提交成功", Severity.Success);
        }
        catch (Exception ex)
        {
            AppendLog($"挂衣杆打印异常：{ex.Message}");
            SnackbarHelper.Show($"异常：{ex.Message}", Severity.Error);
        }
        finally
        {
            IsPrinting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    static void SetHangRailBlockText(PrintLayoutModel layout, string blockName, string content)
    {
        var block = layout.Blocks?.FirstOrDefault(b =>
            string.Equals(b.Name, blockName, StringComparison.OrdinalIgnoreCase));
        if (block?.Text == null) return;
        block.Text.Content = content ?? string.Empty;
    }

    async Task PrintRomaniaSideMarkAsync(int printCount, int startSerial)
    {
        var remark = (_data?.GetString("ZI01") ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(remark))
        {
            SnackbarHelper.Show("当前行生产要求备注为空，找不到对应罗马尼亚模板，无法打印", Severity.Warning);
            AppendLog("罗马尼亚打印拦截：生产要求备注(ZI01)为空");
            return;
        }

        var map = EnsureRomaniaTemplateMap();
        if (map.Count == 0)
        {
            SnackbarHelper.Show("未找到罗马尼亚模板（wwwroot/templates）", Severity.Error);
            return;
        }

        // 多个条码：换行 / 空格 / 斜杠 分隔；每个条码按起始序号..起始+数量-1 连续打
        var tokens = SplitRomaniaRemarkTokens(remark);
        var matched = new List<(string Barcode, string TemplatePath)>();
        foreach (var token in tokens)
        {
            if (!map.TryGetValue(token, out var path))
            {
                AppendLog($"罗马尼亚备注片段未匹配模板，已跳过：{token}");
                continue;
            }

            matched.Add((token, path));
        }

        if (matched.Count == 0)
        {
            SnackbarHelper.Show("当前行生产要求备注无法匹配罗马尼亚模板条码，不能打印", Severity.Warning);
            AppendLog($"罗马尼亚打印拦截：备注未匹配到模板条码，备注={remark}");
            return;
        }

        var endSerial = startSerial + printCount - 1;
        IsPrinting = true;
        AppendLog($"罗马尼亚打印：共 {matched.Count} 个条码，序号 {startSerial} 到 {endSerial}（每个条码连续打 {printCount} 张）");

        try
        {
            foreach (var (barcode, templatePath) in matched)
            {
                string templateJson;
                try
                {
                    templateJson = await File.ReadAllTextAsync(templatePath);
                }
                catch (Exception ex)
                {
                    SnackbarHelper.Show($"读取罗马尼亚模板失败：{ex.Message}", Severity.Error);
                    AppendLog($"读取模板失败：{templatePath}，{ex.Message}");
                    return;
                }

                for (var i = 0; i < printCount; i++)
                {
                    var serialNo = startSerial + i;
                    var layout = JsonConvert.DeserializeObject<PrintLayoutModel>(templateJson);
                    if (layout == null)
                    {
                        SnackbarHelper.Show("罗马尼亚模板解析为空", Severity.Error);
                        return;
                    }

                    layout.PrinterName = SelectedPrinter;
                    layout.PaperWidthMm = 100f;
                    layout.PaperHeightMm = 80f;
                    layout.Copies = 1;
                    layout.StartValue = 1;
                    layout.PrintCount = 1;

                    await PrinterHelper.PrintLayoutAsync(JS, layout);
                    AppendLog($"已提交：条码 {barcode} 第 {serialNo} 张，模板 {Path.GetFileName(templatePath)}");
                }
            }

            await PrinterHelper.SaveLastUsedPrinterAsync(JS, SelectedPrinter, "TrayLabel_printer");
            AppendLog("罗马尼亚打印提交成功。");
            SnackbarHelper.Show($"打印提交成功（{matched.Count} 个条码 × {printCount} 张）", Severity.Success);
        }
        catch (Exception ex)
        {
            AppendLog($"罗马尼亚打印异常：{ex.Message}");
            SnackbarHelper.Show($"异常：{ex.Message}", Severity.Error);
        }
        finally
        {
            IsPrinting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    static List<string> SplitRomaniaRemarkTokens(string remark)
    {
        if (string.IsNullOrWhiteSpace(remark))
            return new List<string>();

        return remark
            .Split(new[] { '\r', '\n', ' ', '/', '\t' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    Dictionary<string, string> EnsureRomaniaTemplateMap()
    {
        if (_romaniaBarcodeTemplateMap != null)
            return _romaniaBarcodeTemplateMap;

        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var dir = Path.Combine(Env.WebRootPath, "templates");
        if (!Directory.Exists(dir))
        {
            _romaniaBarcodeTemplateMap = map;
            return map;
        }

        foreach (var file in Directory.EnumerateFiles(dir, "*罗马尼亚*.json", SearchOption.TopDirectoryOnly))
        {
            try
            {
                var json = File.ReadAllText(file);
                var layout = JsonConvert.DeserializeObject<PrintLayoutModel>(json);
                var barcode = layout?.Blocks?
                    .Select(b => b.Barcode?.Value)
                    .FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))
                    ?.Trim();

                if (string.IsNullOrWhiteSpace(barcode))
                    continue;

                if (map.ContainsKey(barcode))
                {
                    AppendLog($"罗马尼亚条码重复 {barcode}：已用 {Path.GetFileName(map[barcode])}，忽略 {Path.GetFileName(file)}");
                    continue;
                }

                map[barcode] = file;
            }
            catch (Exception ex)
            {
                AppendLog($"加载罗马尼亚模板失败：{Path.GetFileName(file)}，{ex.Message}");
            }
        }

        _romaniaBarcodeTemplateMap = map;
        AppendLog($"已加载罗马尼亚模板 {map.Count} 个（wwwroot/templates）");
        return map;
    }

