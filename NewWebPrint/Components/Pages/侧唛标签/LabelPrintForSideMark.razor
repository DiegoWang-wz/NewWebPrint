@page "/LabelPrintForSideMark"
@inject SnackbarHelper SnackbarHelper
@inject LocalAgentPrinterBootstrap PrinterBootstrap
@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@using NewWebPrint.Models.Api
@using NewWebPrint.Services.SapEwm
@using JsonSerializer = System.Text.Json.JsonSerializer
@implements IAsyncDisposable
@inject ISapEwmService SapEwmService

@rendermode InteractiveServer

<div class="side-mark-shell">
<MudTabs ActivePanelIndex="_sideMarkTabIndex"
         ActivePanelIndexChanged="OnSideMarkTabChanged"
         Elevation="2"
         Rounded="true"
         ApplyEffectsToContainer="true"
         PanelClass="pa-0"
         Class="side-mark-mode-tabs mx-4 mt-1 mb-1 flex-shrink-0">
    <MudTabPanel Text="通用侧唛"></MudTabPanel>
    <MudTabPanel Text="智能家居"></MudTabPanel>
</MudTabs>

<div class="side-mark-page px-4 pb-2">
        <MudPaper Outlined="true" Class="pa-2 section-box side-mark-top">
            <MudGrid Spacing="1" AlignItems="AlignItems.Stretch" Class="mb-2 flex-shrink-0">
                <MudItem xs="12" md="9">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="请输入生产订单号" @bind-Value="ProductionOrder"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="请输入销售/发货订单号" @bind-Value="DeliveryOrSalesOrderNo"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchSubmit"
                               Disabled="@IsSearching" FullWidth="true" Class="action-btn search-btn-tall">
                        @(IsSearching ? "查询中…" : "查询")
                    </MudButton>
                </MudItem>
            </MudGrid>
            @if (IsSearching)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-1 flex-shrink-0"/>
            }
            <div class="table-wrap">
                <MudTable Items="@_tableRows"
                          T="SapEwmDynamicPayload"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.None"
                          FixedHeader="true"
                          Height="100%"
                          OnRowClick="OnTableRowClick"
                          RowClassFunc="GetSideMarkTableRowClass"
                          Class="order-detail-table">
                    <HeaderContent>
                        <MudTh>车间</MudTh>
                        <MudTh>客户</MudTh>
                        <MudTh>客户编码</MudTh>
                        <MudTh>生产订单</MudTh>
                        <MudTh>销售订单</MudTh>
                        <MudTh>物料代码</MudTh>
                        <MudTh>物料名称</MudTh>
                        <MudTh>规格型号</MudTh>
                        <MudTh>订单数量</MudTh>
                        <MudTh>侧唛是否带JCLOGO</MudTh>
                        <MudTh>客户物料标识</MudTh>
                        <MudTh>客户物料名称</MudTh>
                        <MudTh>客户PO</MudTh>
                        <MudTh>中文标识</MudTh>
                        <MudTh>VBBP-ZI10</MudTh>
                        <MudTh>生产要求备注</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><span class="cell-clamp" title="@context.GetString("plant")">@context.GetString("plant")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("customerName")">@context.GetString("customerName")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("customerCode")">@context.GetString("customerCode")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("orderNo")">@context.GetString("orderNo")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("SalesOrderNo")">@context.GetString("SalesOrderNo")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("materialCode")">@context.GetString("materialCode")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("materialName")">@context.GetString("materialName")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("materialModel_zh")">@context.GetString("materialModel_zh")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("orderQuantity")">@context.GetString("orderQuantity")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("jclogoText", "HaveJiecangLOGO")">@context.GetString("jclogoText", "HaveJiecangLOGO")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("materialCodebyClient")">@context.GetString("materialCodebyClient")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("materialNamebyClient")">@context.GetString("materialNamebyClient")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("ZOGEN", "ZCPON")">@context.GetString("ZOGEN", "ZCPON")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("ZMTYPE", "中文标识")">@context.GetString("ZMTYPE", "中文标识")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("ZI10", "STTXT")">@context.GetString("ZI10", "STTXT")</span></MudTd>
                        <MudTd><span class="cell-clamp" title="@context.GetString("ZI01")">@context.GetString("ZI01")</span></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Typo="Typo.body2">暂无数据</MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudPaper>

        <div class="side-mark-bottom">
        <MudGrid Spacing="2" AlignItems="AlignItems.Stretch">
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <div class="result-list-grid">
                                <div class="result-list-item">
                                    <span class="result-list-label">客户</span>
                                    <span class="result-list-value">@(_data?.GetString("customerName") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户物料</span>
                                    <span
                                        class="result-list-value">@(_data?.GetString("materialNamebyClient") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户编码</span>
                                    <span class="result-list-value">@(_data?.GetString("customerCode") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">物料代码</span>
                                    <span class="result-list-value">@(_data?.GetString("materialCode") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">产品名称</span>
                                    <span class="result-list-value">@(_data?.GetString("materialName") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">中文标识</span>
                                    <span class="result-list-value">@(_data?.GetString("ZMTYPE", "中文标识") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">销售订单</span>
                                    <span class="result-list-value">@(_data?.GetString("SalesOrderNo") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">生产订单</span>
                                    <span class="result-list-value">@(_data?.GetString("orderNo") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">侧唛类型</span>
                                    <span
                                        class="result-list-value">@(string.IsNullOrWhiteSpace(LabelType) ? "-" : LabelType)</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户PO</span>
                                    <span class="result-list-value">@(_data?.GetString("ZOGEN") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户物料标识</span>
                                    <span
                                        class="result-list-value">@(_data?.GetString("materialCodebyClient") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">BI10</span>
                                    <span class="result-list-value">@Bi10Value</span>
                                </div>
                            </div>
                        </MudItem>
                        @if (IsSmartHomeTab)
                        {
                            <MudItem xs="12" Class="mt-2 flex-grow-1">
                                <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="140" Class="w-100"/>
                            </MudItem>
                        }
                        @if (!IsSmartHomeTab)
                        {
                            <MudItem xs="12">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1 row-strong">
                                    <MudCheckBox T="bool" @bind-Value="IsInventoryOrder" Label="备库订单"
                                                 Class="row-strong"/>
                                    <MudCheckBox T="bool" @bind-Value="Rotate90" Label="旋转90°" Class="row-strong"/>
                                    <MudSpacer/>
                                    <div class="reprint-range">
                                        <MudText Typo="Typo.body2">补打序列号:</MudText>
                                        <MudTextField T="string"
                                                      @bind-Value="ReprintSerialStart"
                                                      Class="reprint-input"
                                                      Margin="Margin.Dense"
                                                      Variant="Variant.Outlined"/>
                                        <MudText Typo="Typo.body2" Class="mx-1">-</MudText>
                                        <MudTextField T="string"
                                                      @bind-Value="ReprintSerialEnd"
                                                      Class="reprint-input"
                                                      Margin="Margin.Dense"
                                                      Variant="Variant.Outlined"/>
                                    </div>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1" AlignItems="AlignItems.End" Class="mt-1">
                                    <MudItem xs="12" md="4">
                                        <MudGrid Spacing="1" AlignItems="AlignItems.End">
                                            <MudItem xs="12" sm="5" Class="weight-btn-cell">
                                                <MudButton Variant="Variant.Filled"
                                                           Color="@(_isSerialOpen ? Color.Warning : Color.Primary)"
                                                           OnClick="@EnableWeight"
                                                           FullWidth="true"
                                                           Class="weight-btn mt-2">
                                                    @(_isSerialOpen ? "断开称重器" : "开启称重")
                                                </MudButton>
                                            </MudItem>
                                            <MudItem xs="12" sm="7">
                                                <MudTextField T="string" Label="工号" @bind-Value="UserId"
                                                              Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudSpacer/>
                                    <MudItem xs="12" md="6">
                                        <MudGrid Spacing="1" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
                                            <MudItem xs="4" sm="4">
                                                <MudTextField T="string" Label="称重"
                                                              @bind-Value="WeightActual"
                                                              Margin="Margin.Dense"
                                                              Variant="Variant.Outlined"
                                                              ReadOnly="true"/>
                                            </MudItem>
                                            <MudItem xs="4" sm="4">
                                                <MudTextField T="string" Label="标重"
                                                              @bind-Value="WeightStandard"
                                                              Margin="Margin.Dense"
                                                              Variant="Variant.Outlined"
                                                              Disabled="@(!_isSerialOpen)"/>
                                            </MudItem>
                                            <MudItem xs="4" sm="4">
                                                <MudTextField T="string" Label="公差"
                                                              @bind-Value="WeightTolerance"
                                                              Margin="Margin.Dense"
                                                              Variant="Variant.Outlined"
                                                              ReadOnly="true"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel">
                    <MudGrid Spacing="1">
                        <MudItem xs="6">
                            <MudTextField T="string" Label="请输入客户的简称" @bind-Value="CustomerShortName"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="string" Label="请选择打印机" @bind-Value="SelectedPrinter"
                                       Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var p in Printers)
                                {
                                    <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudTextField T="string" Label="此箱数量" @bind-Value="BoxPCS" Margin="Margin.Dense"
                                          Variant="Variant.Outlined"/>
                        </MudItem>
                        @if (IsSmartHomeTab)
                        {
                            <MudItem xs="12" sm="2">
                                <MudTextField T="string" Label="起始序号" @bind-Value="CustomSerialStart"
                                              Margin="Margin.Dense" Variant="Variant.Outlined"/>
                            </MudItem>
                            <MudItem xs="12" sm="2">
                                <MudTextField T="string" Label="打印数量" @bind-Value="StablePrintCount"
                                              Margin="Margin.Dense" Variant="Variant.Outlined"/>
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudDatePicker Label="交货日期" @bind-Date="PrintDate" Margin="Margin.Dense"
                                               Variant="Variant.Outlined"/>
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                               Variant="Variant.Outlined"/>
                            </MudItem>
                        }
                        else
                        {
                            <MudItem xs="12" sm="2">
                                <MudTextField T="string" Label="打印份数" @bind-Value="StablePrintCount"
                                              Margin="Margin.Dense" Variant="Variant.Outlined"/>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudDatePicker Label="交货日期" @bind-Date="PrintDate" Margin="Margin.Dense"
                                               Variant="Variant.Outlined"/>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                               Variant="Variant.Outlined"/>
                            </MudItem>
                        }
                        @if (!IsSmartHomeTab)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" Label="顾家送货单号" @bind-Value="GujiaFireWorkOrderNo"
                                              Margin="Margin.Dense" Variant="Variant.Outlined"/>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" Label="序号抬头" @bind-Value="SerialPrefix" Margin="Margin.Dense"
                                              Variant="Variant.Outlined"/>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <div class="prod-req-remark">生产要求备注：@(_data?.GetString("ZI01") ?? string.Empty)</div>
                        </MudItem>
                        @if (!IsSmartHomeTab)
                        {
                            <MudItem xs="12">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="checkbox-row">
                                    <MudCheckBox T="bool" @bind-Value="IsGujiaSideMarkPrint" Label="顾家侧唛打印"/>
                                    <MudCheckBox T="bool" @bind-Value="IsAddProductionSerialPrint" Label="增加生产序号打印"/>
                                    <MudCheckBox T="bool" @bind-Value="IsYinaSideMarkPrint" Label="伊那侧唛打印"/>
                                </MudStack>
                            </MudItem>
                        }
                        @if (IsSmartHomeTab)
                        {
                            <MudItem xs="12">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1 row-strong">
                                    <MudRadioGroup T="string" @bind-Value="SmartHomeSideMarkType" Class="d-flex flex-row flex-wrap gap-2">
                                        <MudRadio Value="@("宜家侧唛")" Color="Color.Primary" Class="row-strong">宜家侧唛</MudRadio>
                                        <MudRadio Value="@("罗马尼亚侧唛")" Color="Color.Primary" Class="row-strong">罗马尼亚侧唛</MudRadio>
                                        <MudRadio Value="@("挂衣杆侧唛")" Color="Color.Primary" Class="row-strong">挂衣杆侧唛</MudRadio>
                                    </MudRadioGroup>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1" AlignItems="AlignItems.End" Class="mt-1">
                                    <MudItem xs="12" md="4">
                                        <MudGrid Spacing="1" AlignItems="AlignItems.End">
                                            <MudItem xs="12" sm="5" Class="weight-btn-cell">
                                                <MudButton Variant="Variant.Filled"
                                                           Color="@(_isSerialOpen ? Color.Warning : Color.Primary)"
                                                           OnClick="@EnableWeight"
                                                           FullWidth="true"
                                                           Class="weight-btn mt-2">
                                                    @(_isSerialOpen ? "断开称重器" : "开启称重")
                                                </MudButton>
                                            </MudItem>
                                            <MudItem xs="12" sm="7">
                                                <MudTextField T="string" Label="工号" @bind-Value="UserId"
                                                              Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudSpacer/>
                                    <MudItem xs="12" md="6">
                                        <MudGrid Spacing="1" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
                                            <MudItem xs="4" sm="4">
                                                <MudTextField T="string" Label="称重"
                                                              @bind-Value="WeightActual"
                                                              Margin="Margin.Dense"
                                                              Variant="Variant.Outlined"
                                                              ReadOnly="true"/>
                                            </MudItem>
                                            <MudItem xs="4" sm="4">
                                                <MudTextField T="string" Label="标重"
                                                              @bind-Value="WeightStandard"
                                                              Margin="Margin.Dense"
                                                              Variant="Variant.Outlined"
                                                              Disabled="@(!_isSerialOpen)"/>
                                            </MudItem>
                                            <MudItem xs="4" sm="4">
                                                <MudTextField T="string" Label="公差"
                                                              @bind-Value="WeightTolerance"
                                                              Margin="Margin.Dense"
                                                              Variant="Variant.Outlined"
                                                              ReadOnly="true"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="PrintSubmit"
                                       Disabled="@IsPrinting" FullWidth="true" Class="action-btn">
                                @(IsPrinting ? "打印中…" : "直接打印")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (!IsSmartHomeTab)
        {
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="12">
                    <div>
                        <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="160"/>
                    </div>
                </MudItem>
            </MudGrid>
        }
        </div>
</div>
</div>

<style>
    .side-mark-shell {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - 64px);
        min-height: 0;
        overflow: hidden;
    }

    .side-mark-page {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow: auto;
    }

    .side-mark-top {
        flex: 1 1 auto;
        min-height: 220px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .side-mark-bottom {
        flex: 0 0 auto;
    }

    .section-box {
        border-radius: 6px;
    }

    .section-title {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .action-btn {
        min-height: 46px;
        font-weight: 600;
    }

    .weight-btn-cell {
        display: flex;
    }

    .weight-btn {
        height: 40px;
        min-height: 40px;
        max-height: 40px;
    }

    .search-btn-tall {
        height: 100%;
        min-height: 0;
        max-height: 100%;
        font-size: clamp(1rem, 1.2vw, 1.5rem) !important;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .table-wrap {
        flex: 1 1 auto;
        min-height: 160px;
        height: 0;
        overflow: auto;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
    }

    .table-wrap .mud-table-container {
        height: 100%;
    }

    .order-detail-table {
        table-layout: auto;
        width: max-content;
        min-width: 100%;
        height: 100%;
    }

    .order-detail-table th {
        white-space: nowrap !important;
        line-height: 1.2;
        vertical-align: middle;
    }

    .order-detail-table td {
        vertical-align: middle;
        line-height: 1.25;
        max-width: 160px;
        min-width: 72px;
    }

    .order-detail-table .cell-clamp {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        overflow-wrap: anywhere;
        line-height: 1.25;
        max-height: 2.5em;
        white-space: normal;
    }

    .order-detail-table tbody tr {
        cursor: pointer;
    }

    .order-detail-table tbody tr.side-mark-selected-row {
        background-color: #bbdefb !important;
    }

    .order-detail-table tbody tr.side-mark-selected-row:hover {
        background-color: #90caf9 !important;
    }

    .order-detail-table tbody tr.side-mark-selected-row td {
        color: rgba(0, 0, 0, 0.87);
    }

    .result-panel {
        min-height: 0;
    }

    .equal-height-panel {
        width: 100%;
        height: 100%;
    }

    .keypad-box {
        min-height: 0;
    }

    @@media (max-height: 780px) {
        .side-mark-top {
            min-height: 160px;
        }

        .table-wrap {
            min-height: 120px;
        }

        .result-list-label,
        .result-list-value {
            font-size: 0.82rem;
        }
    }

    .bi10-input {
        min-width: 120px;
        max-width: 180px;
    }

    .row-strong {
        color: #111;
        font-weight: 700;
    }

    .plain-chip {
        min-width: 100px;
        padding: 4px 10px;
        border: 1px solid #d0d0d0;
        border-radius: 4px;
        background: #fafafa;
        color: #111;
        font-weight: 700;
        line-height: 24px;
        text-align: center;
    }

    .result-list-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
