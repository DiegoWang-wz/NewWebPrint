@page "/LabelPrintForSideMark"
@inject SnackbarHelper SnackbarHelper
@inject LocalAgentPrinterBootstrap PrinterBootstrap
@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@using NewWebPrint.Models.Api
@using NewWebPrint.Services.SapEwm
@using JsonSerializer = System.Text.Json.JsonSerializer
@implements IAsyncDisposable
@inject ISapEwmService SapEwmService

@rendermode InteractiveServer

<MudGrid Class="pa-4 py-3 side-mark-page"
         GutterSize="2"
         Justify="Justify.Center"
         AlignItems="AlignItems.Start">
    <MudItem xs="12" xl="12">
        <MudPaper Outlined="true" Class="pa-3 mb-3 section-box">
            <MudGrid Spacing="2" AlignItems="AlignItems.Stretch">
                <MudItem xs="12" md="9">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" Label="请输入生产订单号" @bind-Value="ProductionOrder"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="请输入销售/发货订单号" @bind-Value="DeliveryOrSalesOrderNo"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchSubmit"
                               Disabled="@IsSearching" FullWidth="true" Class="action-btn search-btn-tall">
                        @(IsSearching ? "查询中…" : "查询")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <div class="mb-3">
            @if (IsSearching)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-2"/>
            }
            <div class="table-wrap">
                <MudTable Items="@_tableRows"
                          T="SapEwmDynamicPayload"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          OnRowClick="OnTableRowClick"
                          Class="order-detail-table">
                    <HeaderContent>
                        <MudTh>车间</MudTh>
                        <MudTh>客户</MudTh>
                        <MudTh>客户编码</MudTh>
                        <MudTh>生产订单</MudTh>
                        <MudTh>销售订单</MudTh>
                        <MudTh>物料代码</MudTh>
                        <MudTh>物料名称</MudTh>
                        <MudTh>规格型号</MudTh>
                        <MudTh>订单数量</MudTh>
                            <MudTh>侧唛是否带JCLOGO</MudTh>
                        <MudTh>客户物料标识</MudTh>
                            <MudTh>客户物料名称</MudTh>
                            <MudTh>客户PO</MudTh>
                            <MudTh>中文标识</MudTh>
                            <MudTh>VBBP-ZI10</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.GetString("plant")</MudTd>
                        <MudTd>@context.GetString("customerName")</MudTd>
                        <MudTd>@context.GetString("customerCode")</MudTd>
                        <MudTd>@context.GetString("orderNo")</MudTd>
                        <MudTd>@context.GetString("SalesOrderNo")</MudTd>
                        <MudTd>@context.GetString("materialCode")</MudTd>
                        <MudTd>@context.GetString("materialName")</MudTd>
                        <MudTd>@context.GetString("materialModel_zh")</MudTd>
                        <MudTd>@context.GetString("orderQuantity")</MudTd>
                            <MudTd>@context.GetString("jclogoText", "HaveJiecangLOGO")</MudTd>
                        <MudTd>@context.GetString("materialCodebyClient")</MudTd>
                            <MudTd>@context.GetString("materialNamebyClient")</MudTd>
                            <MudTd>@context.GetString("ZOGEN", "ZCPON")</MudTd>
                            <MudTd>@context.GetString("ZMTYPE", "中文标识")</MudTd>
                            <MudTd>@context.GetString("ZI10", "STTXT")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Typo="Typo.body2">暂无数据</MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>

        <MudGrid Spacing="2" Class="mb-3" AlignItems="AlignItems.Stretch">
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <div class="result-list-grid">
                                <div class="result-list-item">
                                    <span class="result-list-label">客户</span>
                                    <span class="result-list-value">@(_data?.GetString("customerName") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户物料</span>
                                    <span
                                        class="result-list-value">@(_data?.GetString("materialNamebyClient") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户编码</span>
                                    <span class="result-list-value">@(_data?.GetString("customerCode") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">物料代码</span>
                                    <span class="result-list-value">@(_data?.GetString("materialCode") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">产品名称</span>
                                    <span class="result-list-value">@(_data?.GetString("materialName") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">中文标识</span>
                                    <span class="result-list-value">@(_data?.GetString("ZMTYPE", "中文标识") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">销售订单</span>
                                    <span class="result-list-value">@(_data?.GetString("SalesOrderNo") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">生产订单</span>
                                    <span class="result-list-value">@(_data?.GetString("orderNo") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">侧唛类型</span>
                                    <span
                                        class="result-list-value">@(string.IsNullOrWhiteSpace(LabelType) ? "-" : LabelType)</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户PO</span>
                                    <span class="result-list-value">@(_data?.GetString("ZOGEN") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">客户物料标识</span>
                                    <span
                                        class="result-list-value">@(_data?.GetString("materialCodebyClient") ?? "-")</span>
                                </div>
                                <div class="result-list-item">
                                    <span class="result-list-label">BI10</span>
                                    <span class="result-list-value">@Bi10Value</span>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1 row-strong">
                                <MudCheckBox T="bool" @bind-Value="IsInventoryOrder" Label="备库订单"
                                             Class="row-strong"/>
                                <MudCheckBox T="bool" @bind-Value="Rotate90" Label="旋转90°" Class="row-strong"/>
                                <MudSpacer/>
                                <div class="reprint-range">
                                    <MudText Typo="Typo.body2">补打序列号:</MudText>
                                    <MudTextField T="string"
                                                  @bind-Value="ReprintSerialStart"
                                                  Class="reprint-input"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"/>
                                    <MudText Typo="Typo.body2" Class="mx-1">-</MudText>
                                    <MudTextField T="string"
                                                  @bind-Value="ReprintSerialEnd"
                                                  Class="reprint-input"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"/>
                                </div>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <MudGrid Spacing="1" AlignItems="AlignItems.End" Class="mt-1">
                                <MudItem xs="12" md="4">
                                    <MudGrid Spacing="1" AlignItems="AlignItems.End">
                                        <MudItem xs="12" sm="5" Class="weight-btn-cell">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(_isSerialOpen ? Color.Warning : Color.Primary)"
                                                       OnClick="@EnableWeight"
                                                       FullWidth="true"
                                                       Class="weight-btn mt-2">
                                                @(_isSerialOpen ? "断开称重器" : "开启称重")
                                            </MudButton>
                                        </MudItem>
                                        <MudItem xs="12" sm="7">
                                            <MudTextField T="string" Label="工号" @bind-Value="UserId"
                                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudSpacer/>
                                <MudItem xs="12" md="6">
                                    <MudGrid Spacing="1" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
                                        <MudItem xs="4" sm="4">
                                            <MudTextField T="string" Label="称重"
                                                          @bind-Value="WeightActual"
                                                          Margin="Margin.Dense"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"/>
                                        </MudItem>
                                        <MudItem xs="4" sm="4">
                                            <MudTextField T="string" Label="标重"
                                                          @bind-Value="WeightStandard"
                                                          Margin="Margin.Dense"
                                                          Variant="Variant.Outlined"
                                                          Disabled="@(!_isSerialOpen)"/>
                                        </MudItem>
                                        <MudItem xs="4" sm="4">
                                            <MudTextField T="string" Label="公差"
                                                          @bind-Value="WeightTolerance"
                                                          Margin="Margin.Dense"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-3 result-panel equal-height-panel">
                    <MudGrid Spacing="1">
                        <MudItem xs="6">
                            <MudTextField T="string" Label="请输入客户的简称" @bind-Value="CustomerShortName"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="string" Label="请选择打印机" @bind-Value="SelectedPrinter"
                                       Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var p in Printers)
                                {
                                    <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudTextField T="string" Label="此箱数量" @bind-Value="BoxPCS" Margin="Margin.Dense"
                                          Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudTextField T="string" Label="打印份数" @bind-Value="StablePrintCount"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudDatePicker Label="交货日期" @bind-Date="PrintDate" Margin="Margin.Dense"
                                           Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudDatePicker Label="生产日期" @bind-Date="ProductionDate" Margin="Margin.Dense"
                                           Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="顾家送货单号" @bind-Value="GujiaFireWorkOrderNo"
                                          Margin="Margin.Dense" Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="序号抬头" @bind-Value="SerialPrefix" Margin="Margin.Dense"
                                          Variant="Variant.Outlined"/>
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="checkbox-row">
                                <MudCheckBox T="bool" @bind-Value="IsGujiaSideMarkPrint" Label="顾家侧唛打印"/>
                                <MudCheckBox T="bool" @bind-Value="IsAddProductionSerialPrint"
                                             Label="增加生产序号打印"/>
                                <MudCheckBox T="bool" @bind-Value="IsYinaSideMarkPrint" Label="伊那侧唛打印"/>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="PrintSubmit"
                                       Disabled="@IsPrinting" FullWidth="true" Class="action-btn">
                                @(IsPrinting ? "打印中…" : "直接打印")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12">
                <div>
                    <OperationLog Content="@PrintMessages" Title="消息输出" HeightPx="200"/>
                </div>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>

