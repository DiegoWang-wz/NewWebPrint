    /// <summary>
    /// Batch/Lot Number = 打包日期(yyMMdd) + 批次号(三位前导零)，如 261022007。
    /// </summary>
    static string FormatBatchLotNumber(string? packingDate, string? batch)
    {
        string datePart = (packingDate ?? "").Trim();
        string batchPart = (batch ?? "").Trim();
        if (int.TryParse(batchPart, out var n))
            batchPart = n.ToString("000");
        else if (batchPart.Length < 3)
            batchPart = batchPart.PadLeft(3, '0');
        return datePart + batchPart;
    }

    /// <summary>
    /// 按工厂类型返回进出口/线性侧唛地址四行（标点已英文化）。
    /// </summary>
    static (string Exporter, string ExporterAddress, string Importer, string ImporterAddress)
        GetCordAddressLines(string? factoryType)
    {
        bool isImportExport = (factoryType ?? "").Contains("进出口");
        if (isImportExport)
        {
            return (
                "Exporter: XINCHANG JIECANG IMPORT AND EXPORT CO., LTD",
                "Address: Xintao Road Qixing Street, Xinchang County,Zhejiang Province,China",
                "Importer: J-STAR MOTION,Hungary KFT.",
                "Address: Füredi utca 103,7400 Kaposvár, Hungary");
        }

        return (
            "Exporter: Zhejiang Jiecang Linear Motion Technology Co., Ltd.",
            "Address: No2, Laisheng Road, Qixing Street,XINCHANG COUNTY,ZHEJIANG,CHINA",
            "Importer: J-STAR MOTION Hungary KFT.",
            "Address: Füredi utca 103,7400 Kaposvár, Hungary");
    }

    static bool ShouldShowDiodePsNote(CORDInfo? info)
    {
        if (info is null) return false;
        return string.Equals(info.JCPartNumber?.Trim(), "20701391", StringComparison.OrdinalIgnoreCase)
               || string.Equals(info.LDPartNumber?.Trim(), "20701391", StringComparison.OrdinalIgnoreCase);
    }

    class CORDInfo
    {
        public CORDInfo(string jCPartNumber, string supplierName, string lDPartNumber,
            string lDPartName, string revisionNumber, double packageWeight, int quantity,
            string factoryType = "线性")
        {
            JCPartNumber = jCPartNumber;
            SupplierName = supplierName;
            LDPartNumber = lDPartNumber;
            LDPartName = lDPartName;
            RevisionNumber = revisionNumber;
            PackageWeight = packageWeight;
            Quantity = quantity;
            FactoryType = string.IsNullOrWhiteSpace(factoryType) ? "线性" : factoryType;
        }

        public static CORDInfo From(CordListDto d)
        {
            return new CORDInfo(
                d.JCPartNumber ?? "",
                d.SupplierName ?? "",
                d.LDPartNumber ?? "",
                d.LDPartName ?? "",
                d.RevisionNumber ?? "",
                (double)(d.PackageWeight ?? 0),
                d.Quantity ?? 0,
                d.FactoryType ?? "线性");
        }

        public string JCPartNumber { get; set; }
        public string SupplierName { get; set; }
        public string LDPartNumber { get; set; }
        public string LDPartName { get; set; }
        public string RevisionNumber { get; set; }
        public double PackageWeight { get; set; }
        public int Quantity { get; set; }
        public string FactoryType { get; set; } = "线性";
        public string Unit { get; set; } = "KG";
    }

