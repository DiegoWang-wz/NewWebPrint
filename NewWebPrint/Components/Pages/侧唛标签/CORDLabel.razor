            SnackbarHelper.Show("LD单号为空", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(quantity))
        {
            SnackbarHelper.Show("打包数量为空", Severity.Warning);
            return;
        }

        var (ok, w, h) = TryParsePaper(PaperSize);
