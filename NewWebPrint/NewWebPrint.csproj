<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="Sap.Data.Hana.Core.v2.1">
        <HintPath>bin\Sap.Data.Hana.Core.v2.1.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AutoMapper" Version="16.1.1" />
      <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
      <PackageReference Include="Blazored.SessionStorage" Version="2.4.0" />
      <PackageReference Include="ClosedXML" Version="0.105.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
      <PackageReference Include="MudBlazor" Version="9.5.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.60" />
      <PackageReference Include="System.IO.Ports" Version="8.0.0" />
      <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
      <PackageReference Include="ZXing.Net" Version="0.16.11" />
      <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Components\Pages\PrintDesign\PrintDesign.razor" />
    </ItemGroup>

    <PropertyGroup>
      <InvariantGlobalization>false</InvariantGlobalization>
      <NeutralResourcesLanguage>zh-CN</NeutralResourcesLanguage>
    </PropertyGroup>

    <ItemGroup>
      <Content Update="wwwroot\downloads\*.*" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
